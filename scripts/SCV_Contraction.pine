//@version=6
// ============================================================================
//  SCV 选股系统 — 第 2 部分：Contraction（收缩形态）
//
//  侦测方式（设置里二选一）：
//    摆动点 = 用 swing high/low 切段（对应手动画法，建议）
//    数蜡烛 = 段内连续3根阴烛/变盘线 + 低点确认（教材原始定义）
//  两种方式的高低点都取「真实峰谷价」，只是切段的触发条件不同
//    做多（多头排列）：每段 C = 一个摆动高点 → 下一个摆动低点
//        深度 =（摆动高 − 摆动低）÷ 摆动高 × 100%
//        C1 动到 50 均线 · 底部抬高（低点逐个抬高）· 结构 = 2~6 段
//        买点 = 末段 ≤ 10%；Base = 突破 C1 高点
//        级联规则：某段 pivot low 跌破上一段 pivot low → 这个低点变成那一段的
//        低点（保留该段高点），比它更深的段清掉（例：C3 跌破 C2 → C3 低点变成
//        C2 低点）。结构条件 = 波段缩小 + 底部抬高（两者都要，可在设置关掉缩小）。
//    做空（空头排列）：镜像 —— 每段 C = 摆动低点 → 摆动高点；Base = 跌破 C1 低点
//    参考实例：Base1  C1 −31.95% → C2 −10.22%
//              Base2  C1 −26.97% → C2 −24.41% → C3 −9.21%
//
//  加分项目（总分 10）：
//    1. 波段收缩合理：Cn ≤ C(n-1) 的一半 + 1%   +3
//    2. C1 深度在 20~35%                          +3
//    3. Base 还是在第 1 或 2 个                    +2
//    4. 突破区域 = Pivot Area                      +2
//  Pivot Area / Cheap / Low Cheap：把 C1 深度切 3 等份
//    做多：顶部=Pivot Area 中间=Cheap 底部=Low Cheap（做空镜像）
//
//  Base 计数：从 Stage 2 开始数（做空从 Stage 4）；跌穿前一个 Base 低点
//    或退回 Stage 4/1（做空：升穿前 Base 高点或回到 Stage 2/1）→ 归零。
// ============================================================================
indicator("SCV - Contraction 收缩形态", shorttitle = "SCV-C", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// ============================== 输入 Inputs ===============================
grpMA = "① 均线（判断多头/空头排列）"
len50  = input.int(50,  "50 均线",  minval = 1, group = grpMA)
len150 = input.int(150, "150 均线", minval = 1, group = grpMA)
len200 = input.int(200, "200 均线", minval = 1, group = grpMA)
showMA = input.bool(true, "显示均线", group = grpMA)

grpC = "② Contraction 侦测"
cMethod        = input.string("数蜡烛", "Contraction 侦测方式", options = ["数蜡烛", "摆动点"], group = grpC, tooltip = "数蜡烛：明显高点到明显低点之间要有连续3根「阴烛/变盘线」的组合 —— 教材对 C 的定义，建议用这个。摆动点：改用 swing high/low 切段（比较宽松，适合肉眼对波段）")
pivStrength    = input.int(5,      "摆动强度（左右各N根K线）", minval = 1, group = grpC, tooltip = "越大 = 只抓大波段、段数少、确认更慢；越小 = 抓小波段、更灵敏但杂讯多。对不上你手画的就调这个")
dojiPct        = input.float(50.0, "变盘线：实体 < K线范围 (%)", minval = 1, maxval = 100, group = grpC, tooltip = "蜡烛分三种：变盘线 = 上下影线合计比实体长（不管阴阳）；阳烛/阴烛 = 实体大过影线合计再看颜色。影线合计 = 范围 − 实体，所以「实体 < 范围的 50%」即为变盘线；调低会更严格")
sealBars       = input.int(3,      "数蜡烛：低点确认K线数", minval = 1, group = grpC, tooltip = "只在「数蜡烛」模式用：回调低点连续这么多根没再被跌破 = 这段收缩结束")
minLegPct      = input.float(1.5,  "最小波段深度 (%)",         minval = 0.1, step = 0.5, group = grpC, tooltip = "小于此深度的摆动当杂讯忽略。太高会漏掉后段小收缩（例如 3% 的 C2），太低会太碎")
requireShrink  = input.bool(true, "结构必须波段缩小（每段比上一段浅）", group = grpC, tooltip = "教材：波段缩小 + 底部抬高。关掉的话只要低点抬高就算新的一段，横盘震荡会画出一堆忽大忽小的 C")
requireTouch50 = input.bool(true,  "C1 必须动到 50均线",       group = grpC)
tol50          = input.float(2.0,  "50均线触碰容差 (%)",       minval = 0, step = 0.5, group = grpC)
buyPct         = input.float(10.0, "买点：最后一段收缩 ≤ (%)", minval = 0.5, step = 0.5, group = grpC)
showBoxes      = input.bool(true,  "画出每段收缩框",           group = grpC)
seedBars       = input.int(50,     "C1 起点回看K线数",         minval = 5, group = grpC, tooltip = "排列刚形成时，C1 的起点(做多=高点/做空=低点)从最近这么多根里的极值算起，可早于排列形成")

grpScore = "③ 加分项目"
c1Min     = input.float(20.0, "加分2：C1 最小深度 (%)", group = grpScore)
c1Max     = input.float(35.0, "加分2：C1 最大深度 (%)", group = grpScore)
shrinkTol = input.float(1.0,  "加分1：收缩合理容差 (± 前段一半)", minval = 0, step = 0.5, group = grpScore, tooltip = "每段要落在「前段一半 ± 此值」之内才算合理。太小(缩太多)或太大(缩太少)都不给分")
c1Pen200  = input.int(3,      "扣分：C1 低点跌到 200均线", minval = 0, group = grpScore, tooltip = "C1 低点(做多)深到碰/跌破 200均线 = 回调太深太弱，扣分（做空镜像）")
showZones = input.bool(true,  "显示 C1 三等份区域（Pivot/Cheap/Low Cheap）", group = grpScore)

grpStage = "④ Stage（用于 Base 计数）"
stageTF  = input.timeframe("D", "Stage 周期", group = grpStage, tooltip = "Stage 固定看此周期的 150 均线（默认天图），与当前图表周期无关。新币/新股改成 240（4小时）")
newTF    = input.timeframe("240", "新图 Stage 周期", group = grpStage, tooltip = "天图还没有 150 均线（新币/新股）时，Stage 自动改看这个周期，默认 4 小时")
slopeLen = input.int(20,    "150均线斜率回看K线数", minval = 2,   group = grpStage)
flatPct  = input.float(1.0, "趋平阈值 (%)",         minval = 0.1, step = 0.1, group = grpStage, tooltip = "和 SCV-Stage 指标用同一套参数，两边保持一致")

grpBuy = "⑤ 买点 / 止损 Buffer"
assetType = input.string("股/币", "资产类型", options = ["股/币", "汇/金/指/期"], group = grpBuy, tooltip = "决定 buffer 怎么算：股/币用固定%；汇/金/指/期按末段C深度的比例")
bufDay    = input.float(1.0,   "股/币：天图 buffer (%)",  minval = 0, step = 0.05, group = grpBuy)
bufHour   = input.float(0.5,   "股/币：时图 buffer (%)",  minval = 0, step = 0.05, group = grpBuy)
bufMin    = input.float(0.25,  "股/币：分图 buffer (%)",  minval = 0, step = 0.05, group = grpBuy)
fxDayHour = input.float(10.0,  "汇/金/指/期：天·时图 末段C% ×", minval = 0, step = 1, group = grpBuy, tooltip = "buffer% =（末段C% × 此值%）÷ 2")
fxMinute  = input.float(5.0,   "汇/金/指/期：分图 末段C% ×",   minval = 0, step = 1, group = grpBuy, tooltip = "buffer% =（末段C% × 此值%）÷ 2")
showBuyLv = input.bool(true,   "画出买点 / 止损线", group = grpBuy)

grpPanel = "⑥ 面板"
panelPosTxt = input.string("右中", "面板位置", options = ["右上", "右中", "右下", "中上", "中下", "左上", "左中", "左下"], group = grpPanel, tooltip = "选面板显示在图上的哪个角落（TradingView 的表格不能用鼠标拖动）")
panelPos = panelPosTxt == "右上" ? position.top_right : panelPosTxt == "右中" ? position.middle_right : panelPosTxt == "右下" ? position.bottom_right : panelPosTxt == "中上" ? position.top_center : panelPosTxt == "中下" ? position.bottom_center : panelPosTxt == "左上" ? position.top_left : panelPosTxt == "左中" ? position.middle_left : position.bottom_left
panelSizeTxt = input.string("小", "面板文字大小", options = ["极小", "小", "正常", "大"], group = grpPanel)
panelSize = panelSizeTxt == "极小" ? size.tiny : panelSizeTxt == "小" ? size.small : panelSizeTxt == "正常" ? size.normal : size.large

// ============================== 均线 & 排列 ================================
ma50  = ta.sma(close, len50)
ma150 = ta.sma(close, len150)
ma200 = ta.sma(close, len200)
plot(showMA ? ma50  : na, "50均线",  color = color.gray, linewidth = 1)
plot(showMA ? ma150 : na, "150均线", color = color.green, linewidth = 2)
plot(showMA ? ma200 : na, "200均线", color = color.red,  linewidth = 2)

// 多头排列 = 150 在 200 上（50 的位置只决定扣分档次，不影响排列成立）
bullStack = ma150 > ma200   // 多头排列 → 侦测做多收缩
bearStack = ma150 < ma200   // 空头排列 → 侦测做空收缩
int mode = bullStack ? 1 : bearStack ? -1 : 0

// ==================== Stage 判断（与 SCV-Stage 同一套逻辑） =================
// Stage 只看 stageTF（默认天图）的 150 均线，与当前图表周期无关
f_stageCalc() =>
    float ma = ta.sma(close, len150)
    float sl = (ma - ma[slopeLen]) / ma[slopeLen] * 100
    bool  up = sl >  flatPct
    bool  dn = sl < -flatPct
    bool  ft = not up and not dn
    var int st    = 1
    var int lastT = 0
    if up and close > ma
        st    := 2
        lastT := 2
    else if dn and close < ma
        st    := 4
        lastT := 4
    else if ft
        st := lastT == 2 ? 3 : 1
    [st, ma]                             // ma 用来判断该周期有没有 150 均线

// 新图自动切换：天图还没有 150 均线（K线不够）→ Stage 改看 4 小时
[stgD, maD] = request.security(syminfo.tickerid, stageTF, f_stageCalc())
[stgN, maN] = request.security(syminfo.tickerid, newTF,   f_stageCalc())
bool   isNewChart  = na(maD)                       // 天图无 150 均线 = 新图
string stageTFUsed = isNewChart ? newTF : stageTF
int    stage       = isNewChart ? stgN : stgD

// ========================= 结构（C1~C6）存储 ===============================
var cStart    = array.new<float>()  // 每段起点：做多=波段高点，做空=波段低点
var cStartBar = array.new<int>()    // 起点K线
var cEnd      = array.new<float>()  // 每段终点：做多=回调低点，做空=反弹高点
var cEndBar   = array.new<int>()    // 终点K线
var cDepth    = array.new<float>()  // 每段深度 (%)
var cTouch    = array.new<bool>()   // 该段是否动到 50 均线
var cBoxes    = array.new<box>()    // 已画的收缩框
var cLabels   = array.new<label>()  // 已画的收缩标签
var box   tentBox   = na            // 实时「C?」框（突破末段高点、新段还没成形时的暂时标记）
var label tentLabel = na            // 实时「C?」标签

f_wipeDraw() =>
    for b in cBoxes
        box.delete(b)
    for l in cLabels
        label.delete(l)
    array.clear(cBoxes)
    array.clear(cLabels)

f_dataClear() =>
    array.clear(cStart)
    array.clear(cStartBar)
    array.clear(cEnd)
    array.clear(cEndBar)
    array.clear(cDepth)
    array.clear(cTouch)

// 成形中重置：连同已画的框/标签一起删掉（重画用）
f_clear() =>
    f_dataClear()
    f_wipeDraw()

// 结构结束（突破/翻转）：保留已画的 C 框与标签当历史，只停止追踪
f_endStructure() =>
    f_dataClear()
    array.clear(cBoxes)
    array.clear(cLabels)

f_push(float s, int sb, float e, int eb, float d, bool t) =>
    array.push(cStart, s)
    array.push(cStartBar, sb)
    array.push(cEnd, e)
    array.push(cEndBar, eb)
    array.push(cDepth, d)
    array.push(cTouch, t)

f_popLast() =>
    array.pop(cStart)
    array.pop(cStartBar)
    array.pop(cEnd)
    array.pop(cEndBar)
    array.pop(cDepth)
    array.pop(cTouch)

// 依结构状态重画所有收缩框 + 标签（级联删段时旧框才不会残留）
f_redraw(bool longDir) =>
    f_wipeDraw()
    int sz = array.size(cDepth)
    if sz > 0
        for i = 0 to sz - 1
            float s  = array.get(cStart, i)
            float e  = array.get(cEnd, i)
            int   sb = array.get(cStartBar, i)
            int   eb = array.get(cEndBar, i)
            float d  = array.get(cDepth, i)
            if showBoxes
                array.push(cBoxes, box.new(sb, math.max(s, e), eb, math.min(s, e), border_color = color.new(color.blue, 30), bgcolor = color.new(color.blue, 90)))
            array.push(cLabels, label.new(eb, e, "C" + str.tostring(i + 1) + " " + str.tostring(d, "#.##") + "%", style = longDir ? label.style_label_up : label.style_label_down, color = color.new(color.blue, 25), textcolor = color.white, size = size.small))

// ============================ 侦测状态 =====================================
var int   activeMode  = 0    // 1=做多侦测, -1=做空侦测, 0=暂停
var bool  lastHiBroken = false // 末段高点是否已被突破（一旦突破，末段低点就此定格，不再实时延伸）
var float anchor      = na   // 收缩起点 = 真实极值（做多=峰值高价，做空=谷值低价）
var int   runCount    = 0    // 数蜡烛模式：当前连续阴烛/变盘线根数
var bool  armed       = false // 数蜡烛模式：本段是否已出现连续3根阴烛/变盘线
var int   anchorBar   = na
var float swingEnd    = na   // 收缩终点 = 起点以来的反向真实极值（做多=最低价，做空=最高价）
var int   swingEndBar = na
var float swingEndMA  = na   // 收缩终点那根的 50 均线值（快照，判断动到均线用）
var bool  swingEndAlign = false  // 收缩终点那根是否为对应排列（C1 要求低点在排列内）
var int   baseCount   = 0    // 已突破的 Base 数量（从 Stage 2 / Stage 4 开始数）
var float lastBaseEnd = na   // 前一个已突破 Base 的低点（做多）/ 高点（做空）
var string lastBaseTxt = "—"  // 最近一次 Base 突破纪录

// 种子极值：排列刚形成时用来定 C1 的起点（可早于排列形成，抓到排列前的真实峰/谷）
float seedHi = ta.highest(high, seedBars)
float seedLo = ta.lowest(low,  seedBars)
int   seedHiBar = bar_index - ta.barssince(high >= seedHi)
int   seedLoBar = bar_index - ta.barssince(low <= seedLo)

// 方向锁定：出现明确多头/空头排列才设定或切换方向（翻成相反排列才清空重来）
// 只有 C1 需要排列；C1 画出后即使排列暂时消失，也继续追踪 C2、C3…
if mode != 0 and mode != activeMode
    activeMode  := mode
    f_clear()
    baseCount   := 0
    lastBaseEnd := na
    armed       := false
    lastHiBroken := false
    anchor      := mode == 1 ? seedHi : seedLo     // 做多种最近高点 / 做空种最近低点
    anchorBar   := mode == 1 ? seedHiBar : seedLoBar
    swingEnd    := na

bool isLong  = activeMode == 1
bool evtBreak = false   // 本根K线发生 Base 突破
bool evtBuy   = false   // 突破且最后一段 ≤ 买点百分比

// ======================= Base 计数重置规则 =================================
// 做多：退回 Stage 4 / Stage 1，或跌穿前一个 Base 的低点 → 归零
// 做空：回到 Stage 2 / Stage 1，或升穿前一个 Base 的高点 → 归零
if activeMode != 0
    bool stageReset = isLong ? (stage == 1 or stage == 4) : (stage == 1 or stage == 2)
    bool undercutPrevBase = not na(lastBaseEnd) and (isLong ? low < lastBaseEnd : high > lastBaseEnd)
    if stageReset or undercutPrevBase
        baseCount   := 0
        lastBaseEnd := na

// ============ 收缩侦测：锚点用「真实最高/最低价」，pivot 只用来判断这段何时结束 ============
float ph = ta.pivothigh(high, pivStrength, pivStrength)
float pl = ta.pivotlow(low,  pivStrength, pivStrength)

if activeMode != 0
    // 1) 追踪真实极值：做多 anchor=最高价、swingEnd=峰值以来最低价；做空镜像
    if isLong
        if na(anchor) or high > anchor
            anchor      := high
            anchorBar   := bar_index
            armed       := false
            runCount    := 0     // 新极值 = 新的一段，连续计数从这根重新算起
            swingEnd    := low
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack
        else if na(swingEnd) or low < swingEnd
            swingEnd    := low
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack
    else
        if na(anchor) or low < anchor
            anchor      := low
            anchorBar   := bar_index
            armed       := false
            runCount    := 0     // 新极值 = 新的一段，连续计数从这根重新算起
            swingEnd    := high
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack
        else if na(swingEnd) or high > swingEnd
            swingEnd    := high
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack

    // 1b) 低点被之后的K跌破 → 实时延伸该段低点（保留高点）；跌破更前面段就往前合并
    //     低点变深是同一段回调的延续，可以实时更新（高点突破才要等新摆动完成）
    //   两条规则：
    //   · 只要 C1 高点没被突破，所有 C 的低点都要跟 C1 低点对查：跌破 C1 低点 → 就变成 C1 的新低点
    //     （一路并回 C1，即使中间某段的高点曾被突破过也照并）
    //   · 只跌破中间/末段低点、还没到 C1 低点：那段的高点一旦先被突破（进入 C? 阶段）就定格，
    //     之后的更低点属于正在形成的新段，不再算进旧段
    if array.size(cDepth) >= 1
        float lastSegHi0 = array.get(cStart, array.size(cDepth) - 1)
        float c1Low0     = array.get(cEnd, 0)
        if not na(anchor) and (isLong ? anchor > lastSegHi0 : anchor < lastSegHi0)
            lastHiBroken := true
        float curLo       = isLong ? low : high
        bool  breaksLast  = isLong ? curLo < array.get(cEnd, array.size(cDepth) - 1) : curLo > array.get(cEnd, array.size(cDepth) - 1)
        bool  breaksC1Low = isLong ? curLo < c1Low0 : curLo > c1Low0
        bool  loBroken    = breaksLast and (breaksC1Low or not lastHiBroken)
        if loBroken
            float newLo = curLo
            while array.size(cDepth) >= 2 and (isLong ? newLo < array.get(cEnd, array.size(cDepth) - 2) : newLo > array.get(cEnd, array.size(cDepth) - 2))
                f_popLast()
            int   lli    = array.size(cDepth) - 1
            float keptHi = array.get(cStart, lli)
            float newD   = isLong ? (keptHi - newLo) / keptHi * 100 : (newLo - keptHi) / keptHi * 100
            array.set(cEnd,    lli, newLo)
            array.set(cEndBar, lli, bar_index)
            array.set(cDepth,  lli, newD)
            f_redraw(isLong)
            if breaksC1Low
                lastHiBroken := false
            // 低点还在加深 = 还在这段回调里 → 下一段的高点必须从这个更低点之后才开始追踪，
            // 否则会把回调途中的反弹高当成新的一段，画出「嵌在里面」的 C
            anchor   := na
            swingEnd := na
            armed    := false

    // 2) 这段收缩什么时候结束 —— 两种侦测方式二选一（设置里切换）
    //    摆动点：反向摆动点(pivot)确认
    //    数蜡烛：段内出现连续3根阴烛/变盘线，且回调低点已 sealBars 根没被跌破
    //   变盘线(变) = 上下影线合计 > 实体（不管阴阳）；做多数 阴/变，做空数 阳/变
    //   连续3根出现在回调的开头/过程/结尾都算；第一根同时是最高和最低也成立
    //   身体 = |收 − 开|；影线合计 = 整根范围 − 身体
    float cBody = math.abs(close - open)
    float cRng  = high - low
    bool  isChg = cRng == 0 or cBody < cRng * dojiPct / 100   // 变盘线（影线合计 > 身体）
    bool  isUpC = not isChg and close > open                  // 阳烛
    bool  isDnC = not isChg and close < open                  // 阴烛
    bool  counterCandle = isLong ? (isDnC or isChg) : (isUpC or isChg)
    runCount := counterCandle ? runCount + 1 : 0
    if runCount >= 3
        armed := true
    bool legEvent = cMethod == "数蜡烛" ? (armed and not na(swingEndBar) and bar_index - swingEndBar >= sealBars) : (isLong ? not na(pl) : not na(ph))
    if legEvent and not na(anchor) and not na(swingEnd)
        float legStart    = anchor
        int   legStartBar = anchorBar
        float legEnd      = swingEnd
        int   legEndBar   = swingEndBar
        float depth  = isLong ? (legStart - legEnd) / legStart * 100 : (legEnd - legStart) / legStart * 100
        // 是否动到 50 均线（用收缩终点那根的均线快照，不做动态回看）
        bool touchedMA = isLong ? legEnd <= swingEndMA * (1 + tol50 / 100) : legEnd >= swingEndMA * (1 - tol50 / 100)
        // 不变量：C 的低点一定要在 C 的高点「之后」才出现（低点 = 高点之后追踪到的反向极值）
        // 正常追踪已保证 swingEndBar ≥ anchorBar；这里显式守一层，杜绝任何「低点在高点之前」的段
        bool afterHigh = legEndBar >= legStartBar

        if depth >= minLegPct and afterHigh
            bool changed = false
            if array.size(cDepth) == 0
                // C1：要求「低点(做多)/高点(做空)那根是对应排列」且「动到 50 均线」
                //     C1 高点不必在排列内，只看低点那根（之后的 C 两项都不检查）
                bool alignOK = swingEndAlign
                if alignOK and (not requireTouch50 or touchedMA)
                    f_push(legStart, legStartBar, legEnd, legEndBar, depth, touchedMA)
                    changed := true
            else
                float lastHigh = array.get(cStart, array.size(cDepth) - 1)
                float lastLow  = array.get(cEnd,   array.size(cDepth) - 1)
                float baseHi   = array.get(cStart, 0)
                bool raisedLow  = isLong ? legEnd > lastLow  : legEnd < lastLow    // 底部抬高
                bool higherHigh = isLong ? (legStart > lastHigh and legStart < baseHi) : (legStart < lastHigh and legStart > baseHi)
                bool breakLow   = isLong ? legEnd < lastLow  : legEnd > lastLow
                float prevDepth = array.get(cDepth, array.size(cDepth) - 1)
                if raisedLow and requireShrink and depth >= prevDepth
                    // ⓪ 底部抬高了，但这段没有比上一段浅 → 收缩结构被破坏
                    //    → 旧结构作废，这一段当作新的 C1 重新开始
                    f_clear()
                    if swingEndAlign and (not requireTouch50 or touchedMA)
                        f_push(legStart, legStartBar, legEnd, legEndBar, depth, touchedMA)
                    changed := true
                else if raisedLow
                    // ① 底部抬高 + 波段缩小 → 新的一段（最多 6 段）。优先于高点规则：
                    //    不管这段的高点比上一段高还是低
                    if array.size(cDepth) < 6
                        f_push(legStart, legStartBar, legEnd, legEndBar, depth, touchedMA)
                        changed := true
                else if higherHigh
                    // ② 低点没抬高，但这段的高点突破了上一段高点（且未破 C1 高点）
                    //    → 更高的高点变成那一段的高点；低点必在这个新高点「之后」，
                    //      所以用这段自己在新高点之后追踪到的新低点（legEnd），旧的、早于新高的低点作废
                    //    （旧的那一段在这个合法的新 C 形成之前一直有效）
                    int hi = array.size(cDepth) - 1
                    array.set(cStart,    hi, legStart)
                    array.set(cStartBar, hi, legStartBar)
                    array.set(cEnd,      hi, legEnd)
                    array.set(cEndBar,   hi, legEndBar)
                    array.set(cDepth,    hi, depth)
                    array.set(cTouch,    hi, touchedMA)
                    changed := true
                else if breakLow
                    // 跌破上一段低点 → 低点级联（保留高点）（例：C3 跌破 C2 → C3 低点变成 C2 低点）
                    while array.size(cDepth) >= 2 and (isLong ? legEnd < array.get(cEnd, array.size(cDepth) - 2) : legEnd > array.get(cEnd, array.size(cDepth) - 2))
                        f_popLast()
                    int   li        = array.size(cDepth) - 1
                    float keptHigh  = array.get(cStart, li)   // 保留该段高点
                    bool  keptTouch = array.get(cTouch, li)
                    float newDepth  = isLong ? (keptHigh - legEnd) / keptHigh * 100 : (legEnd - keptHigh) / keptHigh * 100
                    array.set(cEnd,   li, legEnd)
                    array.set(cEndBar, li, legEndBar)
                    array.set(cDepth, li, newDepth)
                    array.set(cTouch, li, keptTouch or touchedMA)
                    changed := true
            if changed
                f_redraw(isLong)
                lastHiBroken := false   // 末段已更新（新段成形/重写）→ 高点突破状态归零
        // 这段结束 → 从回调低点重新追踪下一段
        anchor      := na
        swingEnd    := na
        armed       := false

// ======================= 加分项目 & 买点（实时计算） ========================
int cN = array.size(cDepth)

// —— 实时「C?」：C 的高点也是实时的 ——
//    价格突破末段高点、但合法的新一段还没成形的那段期间：
//    旧的那一段「暂时」仍然有效（不改动已确认的 C），正在形成的新段先用虚线「C?」标记，
//    等它真正成形（legEvent 触发）再变成正式的 C。突破 C1 高点则属于 Base 突破，不画 C?。
if not na(tentBox)
    box.delete(tentBox)
    tentBox := na
if not na(tentLabel)
    label.delete(tentLabel)
    tentLabel := na
if activeMode != 0 and cN >= 2 and not na(anchor) and not na(swingEnd)
    float lastSegHi = array.get(cStart, cN - 1)   // 末段高点（做空为末段低点）
    float baseHi    = array.get(cStart, 0)        // C1 高点 = Base 突破线
    bool  brokeHi   = isLong ? (anchor > lastSegHi and anchor < baseHi) : (anchor < lastSegHi and anchor > baseHi)
    if brokeHi
        float tDepth = isLong ? (anchor - swingEnd) / anchor * 100 : (swingEnd - anchor) / anchor * 100
        if showBoxes
            tentBox := box.new(anchorBar, math.max(anchor, swingEnd), bar_index, math.min(anchor, swingEnd), border_color = color.new(color.orange, 20), border_style = line.style_dashed, bgcolor = color.new(color.orange, 92))
        tentLabel := label.new(bar_index, swingEnd, "C? " + str.tostring(tDepth, "#.##") + "%", style = isLong ? label.style_label_up : label.style_label_down, color = color.new(color.orange, 20), textcolor = color.white, size = size.small)

// —— 安全取值：数组为空时不碰 array.get/last，避免越界错误 ——
float c1A       = na     // C1 波段起点 = 突破位（做多=高点，做空=低点）
float c1B       = na     // C1 收缩终点（做多=低点，做空=高点）
float c1Depth   = na     // C1 深度
bool  c1Touched = false  // C1 是否动到 50 均线
float lastStart = na     // 最后一段的波段起点
float lastEnd   = na     // 最后一段的终点（做多=低点）
float lastDepth = na     // 最后一段深度
if cN >= 1
    c1A       := array.get(cStart, 0)
    c1B       := array.get(cEnd, 0)
    c1Depth   := array.get(cDepth, 0)
    c1Touched := array.get(cTouch, 0)
    lastStart := array.last(cStart)
    lastEnd   := array.last(cEnd)
    lastDepth := array.last(cDepth)

// 加分1 (+3)：波段收缩合理 —— 每段落在「前一段一半 ± 容差」之内（太小缩太多、太大缩太少都不给分）
bool score1OK = cN >= 2
if score1OK
    for i = 1 to cN - 1
        float half = array.get(cDepth, i - 1) / 2
        float d    = array.get(cDepth, i)
        if d > half + shrinkTol or d < half - shrinkTol
            score1OK := false
// 加分2 (+3)：C1 深度在 20~35%
bool score2OK = cN >= 1 and c1Depth >= c1Min and c1Depth <= c1Max
// 加分3 (+2)：目前形成中的 Base 还是第 1 或第 2 个
bool score3OK = activeMode != 0 and baseCount + 1 <= 2

// —— C1 切成 3 等份 ——
// 做多：顶部 1/3 = Pivot Area，中间 = Cheap，底部 = Low Cheap（做空镜像）
float zThird = (c1A - c1B) / 3                    // 做多为正、做空为负 → 公式两边通用
float z1 = c1A - zThird                           // Pivot Area 与 Cheap 的分界
float z2 = c1A - 2 * zThird                       // Cheap 与 Low Cheap 的分界

// 加分4 (+2)：突破区域 = Pivot Area
//   做多：最后一段收缩的高点 落在 Pivot Area（顶部 1/3）内
//   做空：最后一段收缩的低点 落在 Pivot Area（底部 1/3）内
bool score4OK = cN >= 2 and (isLong ? lastStart >= z1 : lastStart <= z1)
// 扣分：C1 低点(做多)碰/跌破 200均线，或 C1 高点(做空)升到 200均线 = 回调太深太弱
bool c1Reach200 = cN >= 1 and (isLong ? c1B <= ma200 * (1 + tol50 / 100) : c1B >= ma200 * (1 - tol50 / 100))
// C1 到 200 均线的扣分不并进总分，只在面板单独显示
int totalScore = (score1OK ? 3 : 0) + (score2OK ? 3 : 0) + (score3OK ? 2 : 0) + (score4OK ? 2 : 0)

// 买点条件：结构成立（≥2段）且最后一段收缩 ≤ 10%
bool buyZone = cN >= 2 and lastDepth <= buyPct

// ====================== Base 突破（突破 C1 高点/低点） ======================
if activeMode != 0 and array.size(cDepth) >= 1
    float baseLv = array.get(cStart, 0)
    if isLong ? high > baseLv : low < baseLv
        if array.size(cDepth) >= 2
            float lastD = array.last(cDepth)
            evtBreak := true
            evtBuy   := lastD <= buyPct
            baseCount += 1
            lastBaseEnd := array.get(cEnd, 0)   // 这个 Base 的低点(做多)/高点(做空)，跌穿/升穿它 → 计数重置
            string bTxt = (isLong ? "🚀 突破 Base #" : "🔻 跌破 Base #") + str.tostring(baseCount) +
                 (evtBuy ? "\n✅ 买点（末段 " + str.tostring(lastD, "#.##") + "% ≤ " + str.tostring(buyPct, "#.#") + "%）" :
                           "\n⚠️ 末段 " + str.tostring(lastD, "#.##") + "% > " + str.tostring(buyPct, "#.#") + "%") +
                 "\n加分 " + str.tostring(totalScore) + "/10"
            label.new(bar_index, isLong ? low : high, bTxt,
                 style = isLong ? label.style_label_up : label.style_label_down,
                 color = evtBuy ? (isLong ? color.new(color.green, 10) : color.new(color.red, 10)) : color.new(color.orange, 20),
                 textcolor = color.white, size = size.normal)
            lastBaseTxt := (isLong ? "做多" : "做空") + " Base #" + str.tostring(baseCount) + " · 加分 " + str.tostring(totalScore) + "/10" + (evtBuy ? " · ✅买点" : " · ⚠️非买点")
            // 真 base（≥2 段）突破后：保留 C 框/标签当历史
            f_endStructure()
        else
            // 只有 C1 就被突破 = 没形成结构 → 清掉
            f_clear()
        // C1 高点被突破 → 原来的 C1 不再成立（结构结束，从新高重新数下一个 base）
        anchor   := na
        swingEnd := na
        armed    := false
        lastHiBroken := false

// ===================== 买点 / 止损（末段C ± buffer） ========================
// 买点   = 末段 C 的高点 + buffer（做空镜像：末段 C 的低点 − buffer）
// 止损   = 末段 C 的低点 − buffer（做空镜像：末段 C 的高点 + buffer）
// buffer 按资产类型 + 当前图表周期自动选
bool tfDayUp  = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
bool tfHour   = timeframe.isminutes and timeframe.multiplier >= 60
float bufPct  = 0.0
if assetType == "股/币"
    bufPct := tfDayUp ? bufDay : tfHour ? bufHour : bufMin
else if not na(lastDepth)
    bufPct := lastDepth * (tfDayUp or tfHour ? fxDayHour : fxMinute) / 100 / 2
float buyLevel  = na
float stopLevel = na
if cN >= 1
    buyLevel  := isLong ? lastStart * (1 + bufPct / 100) : lastStart * (1 - bufPct / 100)
    stopLevel := isLong ? lastEnd   * (1 - bufPct / 100) : lastEnd   * (1 + bufPct / 100)
float riskPct = na(buyLevel) or na(stopLevel) or buyLevel == 0 ? na : math.abs(buyLevel - stopLevel) / buyLevel * 100
plot(showBuyLv ? buyLevel : na,  "买点（末段C高+buffer）", color = color.new(color.lime, 0),   style = plot.style_linebr, linewidth = 2)
plot(showBuyLv ? stopLevel : na, "止损（末段C低−buffer）", color = color.new(color.maroon, 0), style = plot.style_linebr, linewidth = 2)

// ============================ 图表显示 =====================================
// Base 突破位（C1 波段起点）+ C1 三等份区域
pBrk = plot(c1A, "Base 突破位 (C1)", color = isLong ? color.new(color.green, 0) : color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
pZ1  = plot(showZones ? z1 : na, "Pivot/Cheap 分界",     color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
pZ2  = plot(showZones ? z2 : na, "Cheap/Low Cheap 分界", color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
pBot = plot(showZones ? c1B : na, "C1 收缩终点",         color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
fill(pBrk, pZ1, color = showZones ? color.new(color.green,  82) : na, title = "Pivot Area（靠突破位 1/3）")
fill(pZ1,  pZ2, color = showZones ? color.new(color.yellow, 86) : na, title = "Cheap（中间 1/3）")
fill(pZ2, pBot, color = showZones ? color.new(color.blue,   88) : na, title = "Low Cheap（离突破位最远 1/3）")

// 买点区域背景
bgcolor(buyZone ? color.new(isLong ? color.green : color.red, 85) : na)

plotshape(evtBreak and isLong,     "Base 向上突破", style = shape.triangleup,   location = location.belowbar, color = color.green, size = size.small)
plotshape(evtBreak and not isLong, "Base 向下跌破", style = shape.triangledown, location = location.abovebar, color = color.red,   size = size.small)

// ============================ 信息面板 =====================================
var table panel = table.new(panelPos, 2, 14, border_width = 1, border_color = color.new(color.gray, 60))
f_cell(int row, string k, string v, color c) =>
    table.cell(panel, 0, row, k, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = panelSize, text_halign = text.align_left)
    table.cell(panel, 1, row, v, text_color = color.white, bgcolor = color.new(c, 30), text_size = panelSize, text_halign = text.align_left)

if barstate.islast
    string depthTxt = ""
    if cN > 0
        for i = 0 to cN - 1
            depthTxt += "C" + str.tostring(i + 1) + " " + str.tostring(array.get(cDepth, i), "#.##") + "%  "
    else
        depthTxt := "—"
    string alignLost = activeMode != 0 and mode != activeMode ? "（排列暂失·续追踪）" : ""
    string modeTxt  = (activeMode == 1 ? "多头排列 → 侦测做多" : activeMode == -1 ? "空头排列 → 侦测做空" : "无排列 → 暂停侦测") + "（" + timeframe.period + "）" + alignLost + " · Stage " + str.tostring(stage) + "（" + stageTFUsed + "）"
    string c1maTxt  = cN >= 1 ? (c1Touched ? "✔ 有动到" : "✘ 没动到") : "—"
    string buyTxt   = cN >= 2 ? (buyZone ? "✅ 末段 " + str.tostring(lastDepth, "#.##") + "% ≤ " + str.tostring(buyPct, "#.#") + "%" :
         "未到（末段 " + str.tostring(lastDepth, "#.##") + "%）") : "结构未成立（需 ≥2 段）"
    // 当前价格在 C1 的哪个 1/3 区
    string zoneTxt = cN >= 1 ? (isLong ?
         (close >= z1 ? "Pivot Area（顶部 1/3）" : close >= z2 ? "Cheap（中间 1/3）" : "Low Cheap（底部 1/3）") :
         (close <= z1 ? "Pivot Area（底部 1/3）" : close <= z2 ? "Cheap（中间 1/3）" : "Low Cheap（顶部 1/3）")) : "—"
    color zoneCol = cN >= 1 ? (isLong ? (close >= z1 ? color.green : close >= z2 ? color.orange : color.blue) :
         (close <= z1 ? color.green : close <= z2 ? color.orange : color.blue)) : color.gray

    f_cell(0,  "排列 / 方向",  modeTxt, activeMode == 1 ? color.green : activeMode == -1 ? color.red : color.gray)
    bool countPaused = activeMode == 1 ? (stage == 1 or stage == 4) : activeMode == -1 ? (stage == 1 or stage == 2) : true
    f_cell(1,  "目前 Base",    countPaused ? "计数重置中（Stage " + str.tostring(stage) + "）" :
         "#" + str.tostring(baseCount + 1) + "（已突破 " + str.tostring(baseCount) + " 个）", countPaused ? color.gray : baseCount + 1 <= 2 ? color.teal : color.orange)
    f_cell(2,  "收缩段数",     str.tostring(cN) + "（结构需 2~6 段）", cN >= 2 ? color.teal : color.gray)
    f_cell(3,  "各段深度",     depthTxt, color.gray)
    f_cell(4,  "C1 动到50均线", c1maTxt, cN >= 1 and c1Touched ? color.teal : color.gray)
    f_cell(5,  "买点 (≤10%)",  buyTxt, buyZone ? color.green : color.gray)
    string lvTxt = cN < 1 ? "—" : (isLong ? "买点 " : "空点 ") + str.tostring(buyLevel, format.mintick) +
         " · 止损 " + str.tostring(stopLevel, format.mintick) + " · 风险 " + str.tostring(riskPct, "#.##") + "%（buffer " + str.tostring(bufPct, "#.###") + "%）"
    f_cell(6,  "买点/止损",   lvTxt, cN >= 1 ? color.teal : color.gray)
    f_cell(7,  "价格位置",     zoneTxt, zoneCol)
    f_cell(8,  "加分1 收缩合理 (+3)", score1OK ? "✔" : "✘", score1OK ? color.green : color.gray)
    f_cell(9,  "加分2 C1在20-35% (+3)", score2OK ? "✔" : "✘", score2OK ? color.green : color.gray)
    f_cell(10,  "加分3 Base在1或2 (+2)", score3OK ? "✔" : "✘", score3OK ? color.green : color.gray)
    f_cell(11, "加分4 突破区=Pivot Area (+2)", score4OK ? "✔" : "✘", score4OK ? color.green : color.gray)
    f_cell(12, "总分",         str.tostring(totalScore) + " / 10" + (c1Reach200 ? "  ⚠️C1到200均线 扣-" + str.tostring(c1Pen200) : ""), totalScore >= 8 ? color.green : totalScore >= 5 ? color.teal : color.gray)
    f_cell(13, "最近 Base 突破", lastBaseTxt, color.gray)

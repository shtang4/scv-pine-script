//@version=6
// ============================================================================
//  SCV 选股系统 — 合并版：Stage + Contraction + Volume
//
//  ── S · Stage ──────────────────────────────────────────────────────────
//    以 150 均线方向 + 价格位置判断 Stage 1~4：
//    Stage 1 趋平·横盘至少半年·量低迷 | Stage 2 趋上·做多 | Stage 3 趋平(顶)·
//    跌穿150均线 | Stage 4 趋下·做空。Stage 1 & 3 不做任何交易。
//    加分（做多）：RS 准备破新高 +3 · Stage2+多头排列 +2 · 大小周期同趋势 +1
//    加分（做空）：镜像。50均线灰色 · 150均线绿色 · 200均线红色。
//    旧图（K线数够 200 均线）看天图；新图只有 50 均线 → 看 4 小时图。
//
//  ── C · Contraction ────────────────────────────────────────────────────
//    切段方式设置里二选一：摆动点(swing high/low，建议) 或 数蜡烛(连续3根
//    阴烛/变盘线)。做多（多头排列）：
//    每段 C = 摆动高点 → 下一个摆动低点，深度=(高-低)/高；C1 动到 50 均线；
//    波段缩小·底部抬高；结构 = 2~6 段；买点 = 末段 ≤ 10%；Base = 突破 C1 高点。
//    做空镜像。C1 切 3 等份：靠突破位 1/3 = Pivot Area，中间 = Cheap，
//    最远 1/3 = Low Cheap。参考：Base2 C1 −26.97%→C2 −24.41%→C3 −9.21%。
//    加分（满分10）：收缩合理(每段≤前段一半+1%) +3 · C1 在 20-35% +3 ·
//    Base 在 1或2 +2 · 突破区 = Pivot Area(末段收缩的高点/低点在内) +2
//    Base 计数：从 Stage 2 开始数（做空从 Stage 4）；跌穿前一个 Base 低点
//    或退回 Stage 4/1（做空：升穿前 Base 高点或回到 Stage 2/1）→ 归零。
//
//  ── V · Volume ─────────────────────────────────────────────────────────
//    做多：结构 = 阴烛量小阳烛量大 · 突破 = 放量阳烛 · 日交易金额 > 1百万 ·
//    加分 = 阳烛多阴烛少。做空镜像。
//    （合并版为主图指标，成交量柱请用 TradingView 内建的；放量突破以
//     K线上方圆点标记）
// ============================================================================
indicator("SCV - Stage · Contraction · Volume", shorttitle = "SCV", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// ============================== 输入 Inputs ===============================
grpMA = "① 均线"
len50  = input.int(50,  "50 均线",  minval = 1, group = grpMA)
len150 = input.int(150, "150 均线", minval = 1, group = grpMA)
len200 = input.int(200, "200 均线", minval = 1, group = grpMA)
showMA = input.bool(true, "显示均线", group = grpMA)
stackMode = input.string("宽松：150>200", "多头/空头排列定义", options = ["宽松：150>200", "严格：50>150>200"], group = grpMA, tooltip = "宽松：只要 150 在 200 上就算多头排列，50 的位置只影响扣分档次（C1 可以早一点开始）。严格：要 50 在最上、150 中间、200 最下的完美排列才算（教材定义，C1 会出现得晚、数量少）。空头排列镜像")

grpStage = "② Stage"
stageTF      = input.timeframe("D", "Stage 周期", group = grpStage, tooltip = "Stage 固定看此周期的 150 均线（默认天图），与当前图表周期无关。新币/新股天图没有150均线时改成 240（4小时）")
newTF        = input.timeframe("240", "新图 Stage 周期", group = grpStage, tooltip = "天图还没有 150 均线（新币/新股）时，Stage 自动改看这个周期，默认 4 小时")
slopeLen     = input.int(20,    "150均线斜率回看K线数", minval = 2,   group = grpStage)
flatPct      = input.float(1.0, "趋平阈值 (%)",         minval = 0.1, step = 0.1, group = grpStage)
sidewaysDays = input.int(180,   "Stage 1 横盘最少天数",   minval = 1,  group = grpStage, tooltip = "横盘至少半年 = 180 天。用「日历天数」算（跟 TradingView 量尺的 286d 一样），股票/币都通用")
sidewaysTol  = input.float(3.0, "Stage 1 横盘容差 (%)",   minval = 0,  step = 0.5, group = grpStage, tooltip = "从明显高点算起，价格没有超过该高点×(1+容差) = 还在横盘（涨不上去、突破不上）")
strongPct    = input.float(10.0, "Stage 2 强度门槛 (%)",  minval = 0,  step = 1, group = grpStage, tooltip = "强度 = 价格离 150 均线多远(%)。离越远强度越大、持续性越强；超过此门槛面板标「强」")
steepPct     = input.float(8.0,  "Stage 4 陡度门槛 (%)",  minval = 0,  step = 1, group = grpStage, tooltip = "150均线在回看期内的跌幅。跌得越陡（越接近垂直趋下）下跌延续性越强；超过此门槛面板标「垂直趋下」")
alignPen1    = input.int(1,     "排列小扣分：50在150下",   minval = 0,  group = grpStage, tooltip = "多头排列(150在200上)里，50 在 150 下但仍在 200 上 = 小扣分（做空镜像：50在150上但仍在200下）")
alignPen2    = input.int(2,     "排列大扣分：50在150&200下", minval = 0,  group = grpStage, tooltip = "50 同时在 150 和 200 下 = 大扣分（比只在150下更弱）")
cutDrawdown   = input.float(35.0, "Stage3 清仓跌幅 (%)",     minval = 1, step = 1, group = grpStage, tooltip = "从周期高点回落此% = 清仓信号。股票/加密 ≈35，其他资产 ≈10")
noNewHighBars = input.int(20,     "Stage3 不创新高K线数",    minval = 2, group = grpStage, tooltip = "超过此根数没创周期新高 = 不再创新高")

grpRS = "③ RS Rating（相对强度）"
rsSymbol   = input.symbol("SP:SPX", "对比指数",          group = grpRS)
rsLookback = input.int(252,          "一年回看K线数",     minval = 1, group = grpRS)
rsNearPct  = input.float(2.0,        "接近新高/新低 (%)", minval = 0.1, step = 0.1, group = grpRS)

grpMTF = "④ 大小周期"
bigTF   = input.timeframe("D",  "大周期", group = grpMTF, tooltip = "固定用此周期算 150 均线趋势（默认天图）。新图请改成 240（4小时）。小周期 = 你当前图表的周期，切换图表就跟着变")

grpC = "⑤ Contraction"
cMethod        = input.string("数蜡烛", "Contraction 侦测方式", options = ["数蜡烛", "摆动点"], group = grpC, tooltip = "数蜡烛：明显高点到明显低点之间要有连续3根「阴烛/变盘线」的组合 —— 教材对 C 的定义，建议用这个。摆动点：改用 swing high/low 切段（比较宽松，适合肉眼对波段）")
pivStrength    = input.int(5,      "摆动强度（左右各N根K线）", minval = 1, group = grpC, tooltip = "越大=只抓大波段、段数少、确认慢；越小=更灵敏但杂讯多。对不上手画的就调这个")
dojiPct        = input.float(50.0, "变盘线：实体 < K线范围 (%)", minval = 1, maxval = 100, group = grpC, tooltip = "蜡烛分三种：变盘线 = 上下影线合计比实体长（不管阴阳）；阳烛/阴烛 = 实体大过影线合计再看颜色。影线合计 = 范围 − 实体，所以「实体 < 范围的 50%」即为变盘线；调低会更严格。此定义 S / C / V 全部共用")
sealBars       = input.int(3,      "数蜡烛：低点确认K线数", minval = 1, group = grpC, tooltip = "只在「数蜡烛」模式用：回调低点连续这么多根没再被跌破 = 这段收缩结束")
minLegPct      = input.float(1.5,  "最小波段深度 · 股/币 (%)", minval = 0.01, step = 0.1, group = grpC, tooltip = "小于此深度的摆动当杂讯忽略。太高会漏掉后段小收缩（例如 3% 的 C2），太低会太碎")
minLegPctFx    = input.float(0.2,  "最小波段深度 · 汇/金/指/期 (%)", minval = 0.01, step = 0.05, group = grpC, tooltip = "汇/金/指/期的收缩通常很浅（C1 0.94%、C2 0.67% 很常见），门槛要比股/币小很多，否则整段结构会被当杂讯滤光。按「买点/止损 Buffer → 资产类型」自动选用哪一个")
requireShrink  = input.bool(true, "结构必须波段缩小（每段比上一段浅）", group = grpC, tooltip = "教材：波段缩小 + 底部抬高。关掉的话只要低点抬高就算新的一段，横盘震荡会画出一堆忽大忽小的 C")
requireTouch50 = input.bool(true,  "C1 必须动到 50均线",       group = grpC)
tol50          = input.float(2.0,  "50均线触碰容差 (%)",       minval = 0, step = 0.5, group = grpC)
buyPct         = input.float(10.0, "买点：最后一段收缩 ≤ (%)", minval = 0.5, step = 0.5, group = grpC)
showBoxes      = input.bool(true,  "画出每段收缩框",           group = grpC)
showBaseBox    = input.bool(true,  "Base 成立时框起整个 base", group = grpC, tooltip = "Base 两个条件都成立（C1高点被突破 + 至少2个C）时，用紫色方框把整个 base 框起来")
seedBars       = input.int(50,     "C1 起点回看K线数",         minval = 5, group = grpC, tooltip = "排列刚形成时，C1 的起点(做多=高点/做空=低点)从最近这么多根里的极值算起，可早于排列形成")
c1Min          = input.float(20.0, "加分：C1 最小深度 (%)",    group = grpC)
c1Max          = input.float(35.0, "加分：C1 最大深度 (%)",    group = grpC)
shrinkTol      = input.float(1.0,  "加分：收缩合理容差 (± 前段一半)", minval = 0, step = 0.5, group = grpC, tooltip = "每段要落在「前段一半 ± 此值」之内才算合理。太小(缩太多)或太大(缩太少)都不给分")
c1Pen200       = input.int(3,      "扣分：C1 低点跌到 200均线", minval = 0, group = grpC, tooltip = "C1 低点(做多)深到碰/跌破 200均线 = 回调太深太弱，扣分（做空镜像：C1 高点升到200均线）")
showZones      = input.bool(true,  "显示 C1 三等份区域",       group = grpC)

grpVol = "⑥ Volume"
volLookback  = input.int(20,    "量能回看K线数",          minval = 1, group = grpVol, tooltip = "结构量能与烛数加分的统计期间")
volRatio     = input.float(1.2, "量大倍数",               minval = 1.0, step = 0.1, group = grpVol)
volMALen     = input.int(50,    "交易量均线长度",         minval = 1, group = grpVol)
breakoutMult = input.float(1.5, "突破放量倍数",           minval = 1.0, step = 0.1, group = grpVol, tooltip = "突破量能：当根量 > 交易量均线(MA50)×此倍数 = 放量")
minDollarM   = input.float(1.0, "最低日均交易金额（百万）", minval = 0.1, step = 0.1, group = grpVol)
dollarLB     = input.int(20,    "交易金额平均回看天数",   minval = 1, group = grpVol, tooltip = "取几个交易日的日金额来平均")

grpBuy = "⑦ 买点 / 止损 Buffer"
assetType = input.string("股/币", "资产类型", options = ["股/币", "汇/金/指/期"], group = grpBuy, tooltip = "决定 buffer 怎么算：股/币用固定%；汇/金/指/期按末段C深度的比例")
bufDay    = input.float(1.0,   "股/币：天图 buffer (%)",  minval = 0, step = 0.05, group = grpBuy)
bufHour   = input.float(0.5,   "股/币：时图 buffer (%)",  minval = 0, step = 0.05, group = grpBuy)
bufMin    = input.float(0.25,  "股/币：分图 buffer (%)",  minval = 0, step = 0.05, group = grpBuy)
fxDayHour = input.float(10.0,  "汇/金/指/期：天·时图 末段C% ×", minval = 0, step = 1, group = grpBuy, tooltip = "buffer% =（末段C% × 此值%）÷ 2")
fxMinute  = input.float(5.0,   "汇/金/指/期：分图 末段C% ×",   minval = 0, step = 1, group = grpBuy, tooltip = "buffer% =（末段C% × 此值%）÷ 2")
showBuyLv = input.bool(true,   "画出买点 / 止损线", group = grpBuy)

grpSell = "⑧ 卖出 Sell Trigger"
rrTarget      = input.float(2.0,  "主动①：盈亏比目标 1:X", minval = 0.5, step = 0.5, group = grpSell)
avgProfitPct  = input.float(5.0,  "主动②：平均盈利 (%)",   minval = 0.1, step = 0.5, group = grpSell, tooltip = "你自己的平均单笔盈利，教材手写约 2~8%")
avgProfitMult = input.float(2.5,  "主动②：达到平均盈利的 X 倍", minval = 1, step = 0.5, group = grpSell)
extPct        = input.float(15.0, "主动③：高位 = 离 50均线 (%)", minval = 1, step = 1, group = grpSell, tooltip = "价格高于 50均线此% = 高位（乖离过大）")
atrMult       = input.float(1.2,  "主动③：大波动 = ATR > 均值 ×", minval = 1, step = 0.1, group = grpSell)
sellVolMult   = input.float(1.5,  "主动③④：大交易量 = 量 > 均量 ×", minval = 1, step = 0.1, group = grpSell)
consecDn      = input.int(3,      "主动④：连续阴烛根数",    minval = 2, group = grpSell)
trailBuf      = input.float(1.0,  "被动：50均线/前波段底 下方 buffer (%)", minval = 0, step = 0.25, group = grpSell)
showSellLv    = input.bool(true,  "画出止盈 / 移动止盈线", group = grpSell)

grpPanel = "⑨ 面板"
showS = input.bool(true, "显示 Stage 区块",       group = grpPanel)
showC = input.bool(true, "显示 Contraction 区块", group = grpPanel)
showV = input.bool(true, "显示 Volume 区块",      group = grpPanel)
panelPosTxt = input.string("右中", "面板位置", options = ["右上", "右中", "右下", "中上", "中下", "左上", "左中", "左下"], group = grpPanel, tooltip = "选面板显示在图上的哪个角落（TradingView 的表格不能用鼠标拖动）")
panelPos = panelPosTxt == "右上" ? position.top_right : panelPosTxt == "右中" ? position.middle_right : panelPosTxt == "右下" ? position.bottom_right : panelPosTxt == "中上" ? position.top_center : panelPosTxt == "中下" ? position.bottom_center : panelPosTxt == "左上" ? position.top_left : panelPosTxt == "左中" ? position.middle_left : position.bottom_left
panelSizeTxt = input.string("小", "面板文字大小", options = ["极小", "小", "正常", "大"], group = grpPanel)
panelSize = panelSizeTxt == "极小" ? size.tiny : panelSizeTxt == "小" ? size.small : panelSizeTxt == "正常" ? size.normal : size.large

// ============================== 均线 & 排列 ================================
ma50  = ta.sma(close, len50)
ma150 = ta.sma(close, len150)
ma200 = ta.sma(close, len200)
plot(showMA ? ma50  : na, "50均线",  color = color.gray, linewidth = 1)
plot(showMA ? ma150 : na, "150均线", color = color.green, linewidth = 2)
plot(showMA ? ma200 : na, "200均线", color = color.red,  linewidth = 2)

// 多头排列 = 150 在 200 上（50 的位置只决定扣分档次，不影响排列成立）
// 宽松：只要 150 在 200 上（50 的位置只决定扣分档次）
// 严格：50 在最上、150 中间、200 最下的完美排列（教材定义）
bool strictStack = stackMode == "严格：50>150>200"
bullStack = strictStack ? (ma50 > ma150 and ma150 > ma200) : ma150 > ma200   // 多头排列
bearStack = strictStack ? (ma50 < ma150 and ma150 < ma200) : ma150 < ma200   // 空头排列
int mode = bullStack ? 1 : bearStack ? -1 : 0
// 最小波段深度按资产类型选：汇/金/指/期的 C 通常只有零点几%，门槛要小很多
float minLegUse = assetType == "股/币" ? minLegPct : minLegPctFx

// ============================ S · Stage ====================================
// Stage 只看 stageTF（默认天图）的 150 均线：整套状态机在该周期上计算，
// 所以不管当前图表是 1h / 30m / 15m，Stage 判断都一样
f_stageCalc() =>
    float ma = ta.sma(close, len150)
    float sl = (ma - ma[slopeLen]) / ma[slopeLen] * 100
    bool  up = sl >  flatPct
    bool  dn = sl < -flatPct
    bool  ft = not up and not dn
    var int st    = 1
    var int lastT = 0
    if up and close > ma
        st    := 2
        lastT := 2
    else if dn and close < ma
        st    := 4
        lastT := 4
    else if ft
        st := lastT == 2 ? 3 : 1
    var int fb = 0                      // 横盘（趋平）持续根数，以该周期计
    fb := ft ? fb + 1 : 0
    bool cdn = ta.crossunder(close, ma) // Stage 3 跌穿 150 均线
    // —— Stage 1 / 2 的其余条件（全部在该周期＝天图上算） ——
    float vma = ta.sma(volume, volMALen)           // 50 交易量均线
    bool abv = close > ma               // 价格在 150 均线「上面」
    bool lv  = volume < vma             // Stage1 交易量低迷：量在 50 交易量均线之下
    // Stage2 阳烛量放大 / Stage3 阴烛量放大：该色蜡烛的量超过 50 交易量均线，且比反向的放量烛多
    // 阳烛/阴烛都要「实体大过影线合计」才算数（影线大过实体的是变盘线，两边都不计）
    bool sChg = high - low == 0 or math.abs(close - open) < (high - low) * dojiPct / 100
    int  upB = int(math.sum(not sChg and close > open and volume > vma ? 1 : 0, volLookback))
    int  dnB = int(math.sum(not sChg and close < open and volume > vma ? 1 : 0, volLookback))
    bool bva = upB > dnB                // 阳烛量放大
    bool bea = dnB > upB                // 阴烛量放大
    // Stage2 强度：价格离 150 均线多远（乖离%），越远强度越大、持续性越强
    float stg = (close - ma) / ma * 100
    // 横盘时长：以「明显高点」当区间顶，价格没有明显突破它（涨不上去）就一直算横盘。
    // 用日历天数计（跟 TradingView 量尺的 286d 一样），股票 5 根/周、币 7 根/周都通用。
    var float rTop  = na
    var int   rStart = na
    if na(rTop) or high > rTop * (1 + sidewaysTol / 100)
        rTop   := high                  // 明显突破前高 → 区间重设，横盘重新算起
        rStart := time
    int swD = na(rStart) ? 0 : int((time - rStart) / 86400000)
    [st, sl, fb, cdn, ma, abv, lv, swD, bva, stg, bea]  // ma 用来判断该周期有没有 150 均线

// 新图自动切换：天图还没有 150 均线（K线不够）→ Stage 改看 4 小时
[stgD, slpD, fbD, cdnD, maD, abvD, lvD, swDD, bvaD, stgSD, beaD] = request.security(syminfo.tickerid, stageTF, f_stageCalc())
[stgN, slpN, fbN, cdnN, maN, abvN, lvN, swDN, bvaN, stgSN, beaN] = request.security(syminfo.tickerid, newTF,   f_stageCalc())
bool   isNewChart  = na(maD)                       // 天图无 150 均线 = 新图
string stageTFUsed = isNewChart ? newTF : stageTF  // Stage 实际使用的周期
int    stage       = isNewChart ? stgN : stgD
float  slope150    = isNewChart ? slpN : slpD
int    flatBars    = isNewChart ? fbN  : fbD
bool   crossDn150  = isNewChart ? cdnN : cdnD
bool   priceAbove150 = isNewChart ? abvN : abvD    // 价格在 150 均线上面
bool   stageLowVol   = isNewChart ? lvN  : lvD     // 交易量低迷（量 < 50 交易量均线）
int    sidewaysDur   = isNewChart ? swDN : swDD    // 横盘天数（日历天）
bool   bullVolUp     = isNewChart ? bvaN : bvaD    // Stage2 阳烛量放大
float  stageStrength = isNewChart ? stgSN : stgSD  // Stage2 强度 = 离 150 均线多远(%)
bool   bearVolUp     = isNewChart ? beaN : beaD    // Stage3 阴烛量放大
trendUp   = slope150 >  flatPct
trendDown = slope150 < -flatPct
trendFlat = not trendUp and not trendDown
stage3BreakMA = stage == 3 and crossDn150

// —— Stage 3/4：距周期高点回落（清仓门槛）+ 波动大不创新高 ——
var float cycleHigh = na
if stage == 1 and stage[1] != 1
    cycleHigh := na
cycleHigh := na(cycleHigh) ? high : math.max(cycleHigh, high)
float drawdownPct = na(cycleHigh) or cycleHigh == 0 ? 0.0 : (cycleHigh - close) / cycleHigh * 100
bool cutSignal = (stage == 3 or stage == 4) and drawdownPct >= cutDrawdown   // ≥35%(股/币) → 清仓
float atrNow    = ta.atr(14)
bool  highVol   = not na(atrNow) and atrNow > ta.sma(atrNow, 50)
bool  noNewHigh  = ta.barssince(high >= cycleHigh) >= noNewHighBars
bool  stage3Choppy = stage == 3 and highVol and noNewHigh

// —— 蜡烛分类（S / C / V 全部共用） ——
// 身体 = |收 − 开|；影线合计 = 整根范围 − 身体
//   变盘线 = 影线合计 > 身体（不管阴阳，doji / hammer / shooting star 全算，不用记名字）
//   阳烛   = 身体大过影线合计 且 收 > 开
//   阴烛   = 身体大过影线合计 且 收 < 开
float candBody = math.abs(close - open)
float candRng  = high - low
bool isChg = candRng == 0 or candBody < candRng * dojiPct / 100   // 变盘线
bool isUp  = not isChg and close > open   // 阳烛（实体够大的青烛）
bool isDn  = not isChg and close < open   // 阴烛（实体够大的红烛）
float sumUpVol = math.sum(isUp ? volume : 0, volLookback)
float sumDnVol = math.sum(isDn ? volume : 0, volLookback)
int   cntUp    = int(math.sum(isUp ? 1 : 0, volLookback))
int   cntDn    = int(math.sum(isDn ? 1 : 0, volLookback))
float avgUpVol = cntUp > 0 ? sumUpVol / cntUp : 0
float avgDnVol = cntDn > 0 ? sumDnVol / cntDn : 0
float volMA    = ta.sma(volume, volMALen)
bool upVolDominant = avgUpVol > avgDnVol * volRatio   // 阳烛量放大
bool dnVolDominant = avgDnVol > avgUpVol * volRatio   // 阴烛量放大
bool lowVolume     = volume < volMA   // 交易量低迷 = 量在 50 交易量均线之下
// V 只看「超过 50 交易量均线（橙线）」的蜡烛，橙线以下的一概忽略不计
float cumUpC = ta.cum(isUp and volume > volMA ? 1 : 0)   // 放量阳烛累计数（用于从 C1 起算烛数）
float cumDnC = ta.cum(isDn and volume > volMA ? 1 : 0)   // 放量阴烛累计数
float cumUpV = ta.cum(isUp and volume > volMA ? volume : 0)  // 放量阳烛累计「量」
float cumDnV = ta.cum(isDn and volume > volMA ? volume : 0)  // 放量阴烛累计「量」
// —— Stage 1 成立的四个条件（全部在天图上看 150 均线） ——
//   ① 150 均线趋平  ② 价格在 150 均线上面  ③ 交易量低迷（量 < 50 交易量均线）  ④ 横盘 ≥ 半年
stage1Confirmed = stage == 1 and trendFlat and priceAbove150 and stageLowVol and sidewaysDur >= sidewaysDays
// —— Stage 2 成立的三个条件（同样看天图 150 均线） ——
//   ① 150 均线趋上  ② 阳烛量放大（阳烛量 > 50 交易量均线，且比放量阴烛多）
//   ③ 强度：价格在均线上面，离均线越远强度越大、持续性越强
stage2Confirmed = stage == 2 and trendUp and bullVolUp and priceAbove150
bool stage2Strong = stageStrength >= strongPct
// —— Stage 3 成立的三个条件（Stage 2 涨完之后转下来） ——
//   ① 150 均线趋平  ② 价格跌穿 / 在 150 均线下面  ③ 阴烛量放大
stage3Confirmed = stage == 3 and trendFlat and not priceAbove150 and bearVolUp
// —— Stage 4 = 做空时期 ——
//   ① 150 均线趋下（一进入趋下就是 Stage 4）  ② 价格在 150 均线下面
//   ③ 延续性：均线从慢慢趋下变成「垂直趋下」，跌得越陡延续性越强
//   Stage 4 一路跌到均线开始趋平 = Stage 4 结束、周期循环回 Stage 1（状态机已自动处理）
stage4Confirmed = stage == 4 and trendDown and not priceAbove150
bool stage4Steep = -slope150 >= steepPct   // 垂直趋下 = 均线跌幅够陡

// —— RS 相对强度（近似 RS Rating） ——
benchClose = request.security(rsSymbol, timeframe.period, close)
rsLine     = close / benchClose
rsHigh1Y   = ta.highest(rsLine, rsLookback)
rsLow1Y    = ta.lowest(rsLine, rsLookback)
rsAth      = ta.max(rsLine)
rsAtl      = ta.min(rsLine)
rsNearHigh = rsLine >= rsHigh1Y * (1 - rsNearPct / 100) or rsLine >= rsAth * (1 - rsNearPct / 100)
rsNearLow  = rsLine <= rsLow1Y * (1 + rsNearPct / 100) or rsLine <= rsAtl * (1 + rsNearPct / 100)

// —— 大小周期同趋势：大周期固定 bigTF（默认天图）；小周期 = 当前图表周期（跟着你切换） ——
f_slope150() =>
    ma = ta.sma(close, len150)
    (ma - ma[slopeLen]) / ma[slopeLen] * 100
bigSlope      = request.security(syminfo.tickerid, bigTF, f_slope150())
smallSlope    = (ma150 - ma150[slopeLen]) / ma150[slopeLen] * 100   // 当前图表的 150 均线斜率
sameTrendUp   = bigSlope > flatPct and smallSlope > flatPct
sameTrendDown = bigSlope < -flatPct and smallSlope < -flatPct

// —— 排列品质（三档）：50 在 150&200 上 = 完美 · 50 在 150 下但仍在 200 上 = 小扣
//    · 50 在 150&200 下 = 大扣（做空镜像） ——
int longAlignPen  = ma50 < ma200 ? alignPen2 : ma50 < ma150 ? alignPen1 : 0
int shortAlignPen = ma50 > ma200 ? alignPen2 : ma50 > ma150 ? alignPen1 : 0

// —— S 加分（含排列扣分） ——
int sLongScore = (rsNearHigh ? 3 : 0) + (stage == 2 and bullStack ? 2 : 0) + (sameTrendUp ? 1 : 0) - longAlignPen
int sShortScore = (rsNearLow ? 3 : 0) + (stage == 4 and bearStack ? 2 : 0) + (sameTrendDown ? 1 : 0) - shortAlignPen

// —— 新图 / 旧图 ——
// 新图/旧图由「天图有没有 150 均线」决定（见上面 isNewChart）

// ========================= C · Contraction =================================
var cStart    = array.new<float>()  // 每段起点（做多=高点，做空=低点）
var cStartBar = array.new<int>()    // 起点K线
var cEnd      = array.new<float>()  // 每段终点（做多=回调低点，做空=反弹高点）
var cEndBar   = array.new<int>()    // 终点K线
var cDepth    = array.new<float>()  // 每段深度 (%)
var cTouch    = array.new<bool>()   // 该段是否动到 50 均线
var cBoxes    = array.new<box>()    // 已画的收缩框
var cLabels   = array.new<label>()  // 已画的收缩标签
var box   tentBox   = na            // 实时「C?」框（突破末段高点、新段还没成形时的暂时标记）
var label tentLabel = na            // 实时「C?」标签

f_wipeDraw() =>
    for b in cBoxes
        box.delete(b)
    for l in cLabels
        label.delete(l)
    array.clear(cBoxes)
    array.clear(cLabels)

f_dataClear() =>
    array.clear(cStart)
    array.clear(cStartBar)
    array.clear(cEnd)
    array.clear(cEndBar)
    array.clear(cDepth)
    array.clear(cTouch)

// 成形中重置：连同已画的框/标签一起删掉（重画用）
f_clear() =>
    f_dataClear()
    f_wipeDraw()

// 结构结束（突破/翻转）：保留已画的 C 框与标签当历史，只停止追踪
f_endStructure() =>
    f_dataClear()
    array.clear(cBoxes)
    array.clear(cLabels)

f_push(float s, int sb, float e, int eb, float d, bool t) =>
    array.push(cStart, s)
    array.push(cStartBar, sb)
    array.push(cEnd, e)
    array.push(cEndBar, eb)
    array.push(cDepth, d)
    array.push(cTouch, t)

f_popLast() =>
    array.pop(cStart)
    array.pop(cStartBar)
    array.pop(cEnd)
    array.pop(cEndBar)
    array.pop(cDepth)
    array.pop(cTouch)

// 依结构状态重画所有收缩框 + 标签（级联删段时旧框才不会残留）
f_redraw(bool longDir) =>
    f_wipeDraw()
    int sz = array.size(cDepth)
    if sz > 0
        for i = 0 to sz - 1
            float s  = array.get(cStart, i)
            float e  = array.get(cEnd, i)
            int   sb = array.get(cStartBar, i)
            int   eb = array.get(cEndBar, i)
            float d  = array.get(cDepth, i)
            if showBoxes
                array.push(cBoxes, box.new(sb, math.max(s, e), eb, math.min(s, e), border_color = color.new(color.blue, 30), bgcolor = color.new(color.blue, 90)))
            array.push(cLabels, label.new(eb, e, "C" + str.tostring(i + 1) + " " + str.tostring(d, "#.##") + "%", style = longDir ? label.style_label_up : label.style_label_down, color = color.new(color.blue, 25), textcolor = color.white, size = size.small))

var int   activeMode  = 0
var bool  lastHiBroken = false // 末段高点是否已被突破（一旦突破，末段低点就此定格，不再实时延伸）
var float anchor      = na    // 收缩起点 = 真实极值（做多=峰值高价，做空=谷值低价）
var int   runCount    = 0    // 数蜡烛模式：当前连续阴烛/变盘线根数
var bool  armed       = false // 数蜡烛模式：本段是否已出现连续3根阴烛/变盘线
var int   anchorBar   = na
var float anchorCumUp = na    // 锚点那根的阳烛累计数（快照，避免动态回看）
var float anchorCumDn = na    // 锚点那根的阴烛累计数
var float anchorCumUpV = na   // 锚点那根的放量阳烛累计量（快照）
var float anchorCumDnV = na   // 锚点那根的放量阴烛累计量
var float swingEnd    = na    // 收缩终点 = 起点以来的反向真实极值（做多=最低价，做空=最高价）
var int   swingEndBar = na
var float swingEndMA  = na    // 收缩终点那根的 50 均线值（快照，判断动到均线用）
var bool  swingEndAlign = false  // 收缩终点那根是否为对应排列（C1 要求低点在排列内）
var float c1CumUp     = na    // C1 起点的阳烛累计数（烛数加分从这里算起）
var float c1CumDn     = na    // C1 起点的阴烛累计数
var float c1CumUpV    = na    // C1 起点的放量阳烛累计量（阳烛量大从这里算起）
var float c1CumDnV    = na    // C1 起点的放量阴烛累计量
var int   baseCount   = 0
var float lastBaseEnd = na
var string lastBaseTxt = "—"

// 种子极值：排列刚形成时用来定 C1 的起点（可早于排列形成，抓到排列前的真实峰/谷）
float seedHi = ta.highest(high, seedBars)
float seedLo = ta.lowest(low,  seedBars)
int   seedHiBar = bar_index - ta.barssince(high >= seedHi)
int   seedLoBar = bar_index - ta.barssince(low <= seedLo)

// 方向锁定：出现明确多头/空头排列才设定或切换方向（翻成相反排列才清空重来）
// 只有 C1 需要排列；C1 画出后即使排列暂时消失，也继续追踪 C2、C3…
if mode != 0 and mode != activeMode
    activeMode  := mode
    f_clear()
    baseCount   := 0
    lastBaseEnd := na
    armed       := false
    lastHiBroken := false
    anchor      := mode == 1 ? seedHi : seedLo     // 做多种最近高点 / 做空种最近低点
    anchorBar   := mode == 1 ? seedHiBar : seedLoBar
    anchorCumUp := cumUpC
    anchorCumDn := cumDnC
    anchorCumUpV := cumUpV
    anchorCumDnV := cumDnV
    swingEnd    := na

bool isLong  = activeMode == 1
bool evtBreak = false
bool evtBuy   = false

// —— Base 计数重置：做多退回 Stage 4/1 或跌穿前 Base 低点；做空镜像 ——
if activeMode != 0
    bool stageReset = isLong ? (stage == 1 or stage == 4) : (stage == 1 or stage == 2)
    bool undercutPrevBase = not na(lastBaseEnd) and (isLong ? low < lastBaseEnd : high > lastBaseEnd)
    if stageReset or undercutPrevBase
        baseCount   := 0
        lastBaseEnd := na

// —— 收缩侦测：锚点用「真实最高/最低价」（对齐手动量法），pivot 只用来判断这段何时结束 ——
float ph = ta.pivothigh(high, pivStrength, pivStrength)
float pl = ta.pivotlow(low,  pivStrength, pivStrength)

if activeMode != 0
    // 1) 追踪真实极值：做多 anchor=最高价、swingEnd=峰值以来最低价；做空镜像
    //    同时快照当根的累计烛数 / 50均线值，之后结算时直接用，不做动态回看
    if isLong
        if na(anchor) or high > anchor
            anchor      := high
            anchorBar   := bar_index
            anchorCumUp := cumUpC
            anchorCumDn := cumDnC
            anchorCumUpV := cumUpV
            anchorCumDnV := cumDnV
            armed       := false
            runCount    := 0     // 新极值 = 新的一段，连续计数从这根重新算起
            swingEnd    := low
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack
        else if na(swingEnd) or low < swingEnd
            swingEnd    := low
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack
    else
        if na(anchor) or low < anchor
            anchor      := low
            anchorBar   := bar_index
            anchorCumUp := cumUpC
            anchorCumDn := cumDnC
            anchorCumUpV := cumUpV
            anchorCumDnV := cumDnV
            armed       := false
            runCount    := 0     // 新极值 = 新的一段，连续计数从这根重新算起
            swingEnd    := high
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack
        else if na(swingEnd) or high > swingEnd
            swingEnd    := high
            swingEndBar := bar_index
            swingEndMA  := ma50
            swingEndAlign := isLong ? bullStack : bearStack

    // 1b) 低点被之后的K跌破 → 实时延伸该段低点（保留高点）；跌破更前面段就往前合并
    //     低点变深是同一段回调的延续，可以实时更新（高点突破才要等新摆动完成）
    //   两条规则：
    //   · 只要 C1 高点没被突破，所有 C 的低点都要跟 C1 低点对查：跌破 C1 低点 → 就变成 C1 的新低点
    //     （一路并回 C1，即使中间某段的高点曾被突破过也照并）
    //   · 只跌破中间/末段低点、还没到 C1 低点：那段的高点一旦先被突破（进入 C? 阶段）就定格，
    //     之后的更低点属于正在形成的新段，不再算进旧段
    if array.size(cDepth) >= 1
        float lastSegHi0 = array.get(cStart, array.size(cDepth) - 1)
        float c1Low0     = array.get(cEnd, 0)
        if not na(anchor) and (isLong ? anchor > lastSegHi0 : anchor < lastSegHi0)
            lastHiBroken := true
        float curLo       = isLong ? low : high
        bool  breaksLast  = isLong ? curLo < array.get(cEnd, array.size(cDepth) - 1) : curLo > array.get(cEnd, array.size(cDepth) - 1)
        bool  breaksC1Low = isLong ? curLo < c1Low0 : curLo > c1Low0
        bool  loBroken    = breaksLast and (breaksC1Low or not lastHiBroken)
        if loBroken
            float newLo = curLo
            while array.size(cDepth) >= 2 and (isLong ? newLo < array.get(cEnd, array.size(cDepth) - 2) : newLo > array.get(cEnd, array.size(cDepth) - 2))
                f_popLast()
            int   lli    = array.size(cDepth) - 1
            float keptHi = array.get(cStart, lli)
            float newD   = isLong ? (keptHi - newLo) / keptHi * 100 : (newLo - keptHi) / keptHi * 100
            array.set(cEnd,    lli, newLo)
            array.set(cEndBar, lli, bar_index)
            array.set(cDepth,  lli, newD)
            f_redraw(isLong)
            // 并回 C1（跌破 C1 低点）→ 之前被突破的中间段已删掉，末段又是 C1（高点没破）→ 定格状态归零
            if breaksC1Low
                lastHiBroken := false
            // 低点还在加深 = 还在这段回调里 → 下一段的高点必须从这个更低点之后才开始追踪，
            // 否则会把回调途中的反弹高当成新的一段，画出「嵌在里面」的 C
            anchor   := na
            swingEnd := na
            armed    := false

    // 2) 这段收缩什么时候结束 —— 两种侦测方式二选一（设置里切换）
    //    摆动点：反向摆动点(pivot)确认
    //    数蜡烛：段内出现连续3根阴烛/变盘线，且回调低点已 sealBars 根没被跌破
    //   变盘线(变) = 上下影线合计 > 实体（不管阴阳）；做多数 阴/变，做空数 阳/变
    //   连续3根出现在回调的开头/过程/结尾都算；第一根同时是最高和最低也成立
    //   用上面共用的蜡烛分类：做多数 阴烛/变盘线，做空数 阳烛/变盘线
    bool  counterCandle = isLong ? (isDn or isChg) : (isUp or isChg)
    runCount := counterCandle ? runCount + 1 : 0
    if runCount >= 3
        armed := true
    bool legEvent = cMethod == "数蜡烛" ? (armed and not na(swingEndBar) and bar_index - swingEndBar >= sealBars) : (isLong ? not na(pl) : not na(ph))
    if legEvent and not na(anchor) and not na(swingEnd)
        float legStart    = anchor
        int   legStartBar = anchorBar
        float legEnd      = swingEnd
        int   legEndBar   = swingEndBar
        float depth  = isLong ? (legStart - legEnd) / legStart * 100 : (legEnd - legStart) / legStart * 100
        // 是否动到 50 均线（用收缩终点那根的均线快照，不做动态回看）
        bool touchedMA = isLong ? legEnd <= swingEndMA * (1 + tol50 / 100) : legEnd >= swingEndMA * (1 - tol50 / 100)
        // 不变量：C 的低点一定要在 C 的高点「之后」才出现（低点 = 高点之后追踪到的反向极值）
        // 正常追踪已保证 swingEndBar ≥ anchorBar；这里显式守一层，杜绝任何「低点在高点之前」的段
        bool afterHigh = legEndBar >= legStartBar

        if depth >= minLegUse and afterHigh
            bool changed = false
            if array.size(cDepth) == 0
                // C1：要求「低点(做多)/高点(做空)那根是对应排列」且「动到 50 均线」
                //     C1 高点不必在排列内，只看低点那根（之后的 C 两项都不检查）
                bool alignOK = swingEndAlign
                if alignOK and (not requireTouch50 or touchedMA)
                    f_push(legStart, legStartBar, legEnd, legEndBar, depth, touchedMA)
                    c1CumUp := anchorCumUp   // 记住 C1 起点的累计烛数，烛数加分从这里算起
                    c1CumDn := anchorCumDn
                    c1CumUpV := anchorCumUpV
                    c1CumDnV := anchorCumDnV
                    changed := true
            else
                float lastHigh = array.get(cStart, array.size(cDepth) - 1)
                float lastLow  = array.get(cEnd,   array.size(cDepth) - 1)
                float baseHi   = array.get(cStart, 0)
                bool raisedLow  = isLong ? legEnd > lastLow  : legEnd < lastLow    // 底部抬高
                bool higherHigh = isLong ? (legStart > lastHigh and legStart < baseHi) : (legStart < lastHigh and legStart > baseHi)
                bool breakLow   = isLong ? legEnd < lastLow  : legEnd > lastLow
                float prevDepth = array.get(cDepth, array.size(cDepth) - 1)
                if raisedLow and requireShrink and depth >= prevDepth
                    // ⓪ 底部抬高了，但这段没有比上一段浅 → 收缩结构被破坏
                    //    → 旧结构作废，这一段当作新的 C1 重新开始
                    f_clear()
                    if swingEndAlign and (not requireTouch50 or touchedMA)
                        f_push(legStart, legStartBar, legEnd, legEndBar, depth, touchedMA)
                        c1CumUp := anchorCumUp
                        c1CumDn := anchorCumDn
                        c1CumUpV := anchorCumUpV
                        c1CumDnV := anchorCumDnV
                    changed := true
                else if raisedLow
                    // ① 底部抬高 + 波段缩小 → 新的一段（最多 6 段）。优先于高点规则：
                    //    不管这段的高点比上一段高还是低
                    if array.size(cDepth) < 6
                        f_push(legStart, legStartBar, legEnd, legEndBar, depth, touchedMA)
                        changed := true
                else if higherHigh
                    // ② 低点没抬高，但这段的高点突破了上一段高点（且未破 C1 高点）
                    //    → 更高的高点变成那一段的高点；低点必在这个新高点「之后」，
                    //      所以用这段自己在新高点之后追踪到的新低点（legEnd），旧的、早于新高的低点作废
                    //    （旧的那一段在这个合法的新 C 形成之前一直有效）
                    int hi = array.size(cDepth) - 1
                    array.set(cStart,    hi, legStart)
                    array.set(cStartBar, hi, legStartBar)
                    array.set(cEnd,      hi, legEnd)
                    array.set(cEndBar,   hi, legEndBar)
                    array.set(cDepth,    hi, depth)
                    array.set(cTouch,    hi, touchedMA)
                    changed := true
                else if breakLow
                    // 跌破上一段低点 → 低点级联（保留高点）（例：C3 跌破 C2 → C3 低点变成 C2 低点）
                    while array.size(cDepth) >= 2 and (isLong ? legEnd < array.get(cEnd, array.size(cDepth) - 2) : legEnd > array.get(cEnd, array.size(cDepth) - 2))
                        f_popLast()
                    int   li        = array.size(cDepth) - 1
                    float keptHigh  = array.get(cStart, li)
                    bool  keptTouch = array.get(cTouch, li)
                    float newDepth  = isLong ? (keptHigh - legEnd) / keptHigh * 100 : (legEnd - keptHigh) / keptHigh * 100
                    array.set(cEnd,    li, legEnd)
                    array.set(cEndBar, li, legEndBar)
                    array.set(cDepth,  li, newDepth)
                    array.set(cTouch,  li, keptTouch or touchedMA)
                    changed := true
            if changed
                f_redraw(isLong)
                lastHiBroken := false   // 末段已更新（新段成形/重写）→ 高点突破状态归零
        // 这段结束 → 从回调低点重新追踪下一段
        anchor      := na
        swingEnd    := na
        armed       := false

// —— C 加分 & 买点 ——
int cN = array.size(cDepth)

// —— 实时「C?」：C 的高点也是实时的 ——
//    价格突破末段高点、但合法的新一段还没成形的那段期间：
//    旧的那一段「暂时」仍然有效（不改动已确认的 C），正在形成的新段先用虚线「C?」标记，
//    等它真正成形（legEvent 触发）再变成正式的 C。突破 C1 高点则属于 Base 突破，不画 C?。
if not na(tentBox)
    box.delete(tentBox)
    tentBox := na
if not na(tentLabel)
    label.delete(tentLabel)
    tentLabel := na
if activeMode != 0 and cN >= 2 and not na(anchor) and not na(swingEnd)
    float lastSegHi = array.get(cStart, cN - 1)   // 末段高点（做空为末段低点）
    float baseHi    = array.get(cStart, 0)        // C1 高点 = Base 突破线
    bool  brokeHi   = isLong ? (anchor > lastSegHi and anchor < baseHi) : (anchor < lastSegHi and anchor > baseHi)
    if brokeHi
        float tDepth = isLong ? (anchor - swingEnd) / anchor * 100 : (swingEnd - anchor) / anchor * 100
        if showBoxes
            tentBox := box.new(anchorBar, math.max(anchor, swingEnd), bar_index, math.min(anchor, swingEnd), border_color = color.new(color.orange, 20), border_style = line.style_dashed, bgcolor = color.new(color.orange, 92))
        tentLabel := label.new(bar_index, swingEnd, "C? " + str.tostring(tDepth, "#.##") + "%", style = isLong ? label.style_label_up : label.style_label_down, color = color.new(color.orange, 20), textcolor = color.white, size = size.small)

// —— 安全取值：数组为空时不碰 array.get/last，避免越界错误 ——
float c1A       = na     // C1 波段起点（做多=高点，做空=低点）= 突破位
float c1B       = na     // C1 收缩终点
float c1Depth   = na     // C1 深度
bool  c1Touched = false  // C1 是否动到 50 均线
float lastStart = na     // 最后一段的波段起点
float lastEnd   = na     // 最后一段的终点（做多=低点）
float lastDepth = na     // 最后一段深度
if cN >= 1
    c1A       := array.get(cStart, 0)
    c1B       := array.get(cEnd, 0)
    c1Depth   := array.get(cDepth, 0)
    c1Touched := array.get(cTouch, 0)
    lastStart := array.last(cStart)
    lastEnd   := array.last(cEnd)
    lastDepth := array.last(cDepth)

// 加分1：每段收缩要落在「前段一半 ± 容差」之内（太小缩太多、太大缩太少都不给分）
bool score1OK = cN >= 2
if score1OK
    for i = 1 to cN - 1
        float half = array.get(cDepth, i - 1) / 2
        float d    = array.get(cDepth, i)
        if d > half + shrinkTol or d < half - shrinkTol
            score1OK := false
bool score2OK = cN >= 1 and c1Depth >= c1Min and c1Depth <= c1Max
bool score3OK = activeMode != 0 and baseCount + 1 <= 2

// C1 切 3 等份：做多 顶部=Pivot Area 中间=Cheap 底部=Low Cheap（做空镜像）
float zThird = (c1A - c1B) / 3
float z1 = c1A - zThird
float z2 = c1A - 2 * zThird

// 加分4：最后一段收缩的高点(做多)/低点(做空) 落在 Pivot Area 内
bool score4OK = cN >= 2 and (isLong ? lastStart >= z1 : lastStart <= z1)
// 扣分：C1 低点(做多)碰/跌破 200均线，或 C1 高点(做空)升到 200均线 = 回调太深太弱
bool c1Reach200 = cN >= 1 and (isLong ? c1B <= ma200 * (1 + tol50 / 100) : c1B >= ma200 * (1 - tol50 / 100))
// C1 到 200 均线的扣分不并进总分，只在面板单独显示
int cScore = (score1OK ? 3 : 0) + (score2OK ? 3 : 0) + (score3OK ? 2 : 0) + (score4OK ? 2 : 0)
bool buyZone = cN >= 2 and lastDepth <= buyPct

// ============================ V · Volume ===================================
// —— 条件① 阳烛量大 ——
// 只看「超过 50 交易量均线（橙线）」的蜡烛，橙线以下的一概忽略不计。
// 统计区间：已经有 C1 → 从 C1 起点算到现在（C1~C6 整个 base 期间）；
//           还没有 C1 → 退回用固定回看期，面板才不会空着。
float bigUpVol = 0.0
float bigDnVol = 0.0
if cN >= 1 and not na(c1CumUpV)
    bigUpVol := cumUpV - c1CumUpV
    bigDnVol := cumDnV - c1CumDnV
else
    bigUpVol := math.sum(isUp and volume > volMA ? volume : 0, volLookback)
    bigDnVol := math.sum(isDn and volume > volMA ? volume : 0, volLookback)
bool structVolOK = mode != 0 and (isLong ? bigUpVol > bigDnVol * volRatio : bigDnVol > bigUpVol * volRatio)
bool bigVol = volume > volMA * breakoutMult
bool breakoutVolOK = mode != 0 and bigVol and (isLong ? isUp : isDn)
// 日均交易金额：不管图表周期，都强制取「天」的 收盘价×成交量 再平均
// （日内图上直接 close*volume 算的是每根K线的金额，会比真正的日金额小很多）
float avgDollarVol = request.security(syminfo.tickerid, "D", ta.sma(close * volume, dollarLB))
bool liqOK = avgDollarVol > minDollarM * 1000000
// 另外单看「过去 24 小时」的交易金额有没有超过门槛：
// 取 1 小时图的 收盘价×成交量，滚动累加最近 24 根（= 过去 24 小时，币 7×24 连续）
float h24DollarVol = request.security(syminfo.tickerid, "60", math.sum(close * volume, 24))
bool dayLiqOK = h24DollarVol > minDollarM * 1000000
// 烛数加分：从 C1 起点算到现在（整个 base 期间）的阳烛 vs 阴烛数量
// 用 C1 起点的累计烛数快照差分，避免动态回看
int cntUpBase = 0
int cntDnBase = 0
if cN >= 1 and not na(c1CumUp)
    cntUpBase := int(cumUpC - c1CumUp)
    cntDnBase := int(cumDnC - c1CumDn)
bool vBonusOK = mode != 0 and cN >= 1 and (isLong ? cntUpBase > cntDnBase : cntDnBase > cntUpBase)

// ====================== C · Base 突破（需 V 一起看） ========================
// Base 成立要两个条件：① C1 的高点被突破（用蜡烛的「最高价」去比，不看收盘、不看阴阳）
//                      ② 这个 base 里至少有 2 个 C（只有 C1 不算 base）
if activeMode != 0 and array.size(cDepth) >= 1
    float baseLv = array.get(cStart, 0)
    if isLong ? high > baseLv : low < baseLv
        if array.size(cDepth) >= 2
            float lastD = array.last(cDepth)
            evtBreak := true
            evtBuy   := lastD <= buyPct
            baseCount += 1
            lastBaseEnd := array.get(cEnd, 0)
            // 把整个 base 框起来：从 C1 起点那根到突破这根，上=C1高点，下=各段最低点
            if showBaseBox
                float bTop = baseLv
                float bBot = array.get(cEnd, 0)
                for i = 1 to array.size(cDepth) - 1
                    bBot := isLong ? math.min(bBot, array.get(cEnd, i)) : math.max(bBot, array.get(cEnd, i))
                box.new(array.get(cStartBar, 0), math.max(bTop, bBot), bar_index, math.min(bTop, bBot),
                     border_color = evtBuy ? color.new(color.purple, 0) : color.new(color.purple, 45),
                     border_width = 2, bgcolor = color.new(color.purple, 93))
            string volNote = breakoutVolOK ? "\n量能 ✔ 放量" + (isLong ? "阳烛" : "阴烛") : "\n量能 ✘ 未放量"
            string bTxt = (isLong ? "🚀 突破 Base #" : "🔻 跌破 Base #") + str.tostring(baseCount) +
                 (evtBuy ? "\n✅ 买点（末段 " + str.tostring(lastD, "#.##") + "% ≤ " + str.tostring(buyPct, "#.#") + "%）" :
                           "\n⚠️ 末段 " + str.tostring(lastD, "#.##") + "% > " + str.tostring(buyPct, "#.#") + "%") +
                 "\nC 加分 " + str.tostring(cScore) + "/10" + volNote
            label.new(bar_index, isLong ? low : high, bTxt,
                 style = isLong ? label.style_label_up : label.style_label_down,
                 color = evtBuy ? (isLong ? color.new(color.green, 10) : color.new(color.red, 10)) : color.new(color.orange, 20),
                 textcolor = color.white, size = size.normal)
            lastBaseTxt := (isLong ? "做多" : "做空") + " Base #" + str.tostring(baseCount) + " · C " + str.tostring(cScore) + "/10" +
                 (evtBuy ? " · ✅买点" : " · ⚠️非买点") + (breakoutVolOK ? " · 放量✔" : " · 放量✘")
            // 真 base（≥2 段）突破后：保留 C 框/标签当历史
            f_endStructure()
        else
            // 只有 C1 就被突破 = 没形成结构 → 清掉
            f_clear()
        // C1 高点被突破 → 原来的 C1 不再成立（结构结束，从新高重新数下一个 base）
        anchor   := na
        swingEnd := na
        armed    := false
        lastHiBroken := false

// ===================== 买点 / 止损（末段C ± buffer） ========================
// 买点   = 末段 C 的高点 + buffer（做空镜像：末段 C 的低点 − buffer）
// 止损   = 末段 C 的低点 − buffer（做空镜像：末段 C 的高点 + buffer）
// buffer 按资产类型 + 当前图表周期自动选
bool tfDayUp  = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
bool tfHour   = timeframe.isminutes and timeframe.multiplier >= 60
float bufPct  = 0.0
if assetType == "股/币"
    bufPct := tfDayUp ? bufDay : tfHour ? bufHour : bufMin
else if not na(lastDepth)
    bufPct := lastDepth * (tfDayUp or tfHour ? fxDayHour : fxMinute) / 100 / 2
float buyLevel  = na
float stopLevel = na
if cN >= 1
    buyLevel  := isLong ? lastStart * (1 + bufPct / 100) : lastStart * (1 - bufPct / 100)
    stopLevel := isLong ? lastEnd   * (1 - bufPct / 100) : lastEnd   * (1 + bufPct / 100)
float riskPct = na(buyLevel) or na(stopLevel) or buyLevel == 0 ? na : math.abs(buyLevel - stopLevel) / buyLevel * 100
plot(showBuyLv ? buyLevel : na,  "买点（末段C高+buffer）", color = color.new(color.lime, 0),   style = plot.style_linebr, linewidth = 2)
plot(showBuyLv ? stopLevel : na, "止损（末段C低−buffer）", color = color.new(color.maroon, 0), style = plot.style_linebr, linewidth = 2)

// ===================== 卖出 Sell Trigger =================================
// 主动套利 Take Profit：① 盈亏比达标 ② 利润达平均盈利的 2~3 倍
//                      ③ 高位+大波动+大交易量 ④ 连续阴烛后出现大量阴烛
// 被动套利 Ride The Trend（Stage 2 且 Base 1~2 才适用）：
//                      移动止盈 = 50均线 / 前波段底部 之下加 buffer
float tpRR  = na(buyLevel) or na(stopLevel) ? na : (isLong ? buyLevel + (buyLevel - stopLevel) * rrTarget : buyLevel - (stopLevel - buyLevel) * rrTarget)
float tpAvg = na(buyLevel) ? na : (isLong ? buyLevel * (1 + avgProfitPct * avgProfitMult / 100) : buyLevel * (1 - avgProfitPct * avgProfitMult / 100))

// ③ 高位 + 大波动 + 大交易量
bool sellExtended = isLong ? close > ma50 * (1 + extPct / 100) : close < ma50 * (1 - extPct / 100)
bool sellBigMove  = not na(atrNow) and atrNow > ta.sma(atrNow, 50) * atrMult
bool sellBigVol   = volume > volMA * sellVolMult
bool sellClimax   = activeMode != 0 and sellExtended and sellBigMove and sellBigVol

// ④ 连续阴烛后，出现大交易量的阴烛（做空镜像：连续阳烛后出现大量阳烛）
var int sellRun = 0
sellRun := (isLong ? isDn : isUp) ? sellRun + 1 : 0
bool sellVolDump = activeMode != 0 and (isLong ? isDn : isUp) and sellRun >= consecDn and volume > volMA * sellVolMult

// 被动套利：Stage 2（做空 Stage 4）且 Base 还在 1~2 → 让利润跑，用移动止盈
bool rideMode = activeMode != 0 and (isLong ? stage == 2 : stage == 4) and baseCount + 1 <= 2
float trailMA    = isLong ? ma50 * (1 - trailBuf / 100) : ma50 * (1 + trailBuf / 100)
float trailSwing = na(lastEnd) ? na : (isLong ? lastEnd * (1 - trailBuf / 100) : lastEnd * (1 + trailBuf / 100))
float trailLevel = na(trailSwing) ? trailMA : (isLong ? math.max(trailMA, trailSwing) : math.min(trailMA, trailSwing))

plot(showSellLv and not na(tpRR) ? tpRR : na, "止盈（盈亏比目标）", color = color.new(color.yellow, 0), style = plot.style_linebr, linewidth = 2)
plot(showSellLv and rideMode ? trailLevel : na, "移动止盈（50均线/前波段底−buffer）", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
plotshape(sellClimax and not sellClimax[1], "卖出③ 高位大波动大量", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 10), text = "高位大量", textcolor = color.white, size = size.tiny)
plotshape(sellVolDump and not sellVolDump[1], "卖出④ 连续阴烛后大量阴烛", style = shape.labeldown, location = location.abovebar, color = color.new(color.maroon, 10), text = "连阴大量", textcolor = color.white, size = size.tiny)

// ============================ 图表显示 =====================================
// Stage 背景 & 转换标签
stageColor = stage == 1 ? color.gray : stage == 2 ? color.green : stage == 3 ? color.orange : color.red
bgcolor(color.new(stageColor, stage == 1 or stage == 3 ? 88 : 94), title = "Stage 背景")
if stage != stage[1]
    label.new(bar_index, high, "Stage " + str.tostring(stage), style = label.style_label_down,
         color = color.new(stageColor, 20), textcolor = color.white, size = size.small)
plotshape(stage3BreakMA and not stage3BreakMA[1], "Stage3 跌穿150均线", style = shape.xcross, location = location.belowbar, color = color.orange, size = size.small)
plotshape(cutSignal and not cutSignal[1], "清仓信号", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.normal, text = "清仓")
plotshape(stage3Choppy and not stage3Choppy[1], "波动大不创新高", style = shape.diamond, location = location.abovebar, color = color.orange, size = size.tiny)

// C1 突破位 + 三等份区域
pBrk = plot(c1A, "Base 突破位 (C1)", color = isLong ? color.new(color.green, 0) : color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
pZ1  = plot(showZones ? z1 : na, "Pivot/Cheap 分界",     color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
pZ2  = plot(showZones ? z2 : na, "Cheap/Low Cheap 分界", color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
pBot = plot(showZones ? c1B : na, "C1 收缩终点",         color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
fill(pBrk, pZ1, color = showZones ? color.new(color.green,  82) : na, title = "Pivot Area")
fill(pZ1,  pZ2, color = showZones ? color.new(color.yellow, 86) : na, title = "Cheap")
fill(pZ2, pBot, color = showZones ? color.new(color.blue,   88) : na, title = "Low Cheap")

// 买点区域背景 & Base 突破三角
bgcolor(buyZone ? color.new(isLong ? color.green : color.red, 85) : na, title = "买点区域背景")
plotshape(evtBreak and isLong,     "Base 向上突破", style = shape.triangleup,   location = location.belowbar, color = color.green, size = size.small)
plotshape(evtBreak and not isLong, "Base 向下跌破", style = shape.triangledown, location = location.abovebar, color = color.red,   size = size.small)

// 放量突破烛（V）：K线上方圆点
plotshape(breakoutVolOK and isLong,     "放量阳烛", style = shape.circle, location = location.abovebar, color = color.new(color.green, 20), size = size.tiny)
plotshape(breakoutVolOK and not isLong, "放量阴烛", style = shape.circle, location = location.abovebar, color = color.new(color.red, 20),   size = size.tiny)

// ============================ 信息面板 =====================================
var table panel = table.new(panelPos, 2, 31, border_width = 1, border_color = color.new(color.gray, 60))
f_cell(int row, string k, string v, color c) =>
    table.cell(panel, 0, row, k, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = panelSize, text_halign = text.align_left)
    table.cell(panel, 1, row, v, text_color = color.white, bgcolor = color.new(c, 30), text_size = panelSize, text_halign = text.align_left)
    row + 1

if barstate.islast
    table.clear(panel, 0, 0, 1, 30)
    int r = 0

    // —— 综合 ——
    // 排列跟着当前图表周期算，括号里标出是哪个周期
    string stackTxt = (bullStack ? "多头排列" : bearStack ? "空头排列" : "无排列") + "（" + timeframe.period + (strictStack ? " 严格" : " 宽松") + "）"
    // 可否交易 = 天图 Stage 与当前周期排列是否一致：
    //   Stage 1/3 → 不交易 (S)
    //   Stage 2 + 多头排列 → 可交易 (多 S+)；Stage 2 + 空头排列 → 不交易 (多 S-)
    //   Stage 4 + 空头排列 → 可交易 (空 S+)；Stage 4 + 多头排列 → 不交易 (空 S-)
    string tradeTxt = "⛔ 不交易 (S)"
    bool   tradeOK  = false
    if stage == 2
        tradeTxt := bullStack ? "✅ 可交易 (多 S+)" : "⛔ 不交易 (多 S-)"
        tradeOK  := bullStack
    else if stage == 4
        tradeTxt := bearStack ? "✅ 可交易 (空 S+)" : "⛔ 不交易 (空 S-)"
        tradeOK  := bearStack

    // —— Selection 选股：S 找动能 · C 找买点 · V 找流动性 ——
    //   S+C+V → 有大庄 | 只有 S+C → 调仓位 | 只有 S+V → 等买点 | 只有 C+V → 调低盈亏比
    bool selS = tradeOK                    // 动能：天图 Stage 与当前周期排列同向
    bool selC = cN >= 2 and buyZone        // 买点：结构成立(≥2段) 且 末段 ≤ 买点%
    bool selV = dayLiqOK                   // 流动性：看「当日交易金额」达标（日均那项只当参考显示）
    string selFlag = (selS ? "S+" : "S-") + (selC ? " C+" : " C-") + (selV ? " V+" : " V-")
    string selTxt = "⛔ 不合格"
    color  selCol = color.gray
    if selS and selC and selV
        selTxt := "✅ 有大庄"
        selCol := color.green
    else if selS and selC
        selTxt := "⚠️ 调仓位（流动性不足）"
        selCol := color.orange
    else if selS and selV
        selTxt := "⏳ 等买点"
        selCol := color.teal
    else if selC and selV
        selTxt := "⚠️ 调低盈亏比（无动能）"
        selCol := color.orange
    r := f_cell(r, "SCV 选股", selTxt + " · " + selFlag, selCol)
    r := f_cell(r, "选股明细", "S 动能" + (selS ? "✔" : "✘") + " · C 买点" + (selC ? "✔" : "✘") + " · V 流动" + (selV ? "✔" : "✘"),
         selS and selC and selV ? color.green : color.gray)

    string comboExtra = ""
    if stage == 3 or stage == 4
        comboExtra := " · 距高 -" + str.tostring(drawdownPct, "#.#") + "%" + (cutSignal ? " ⚠️清仓" : "")
    if stage3Choppy
        comboExtra := comboExtra + " · 波动大不创新高"
    r := f_cell(r, "SCV 综合", "Stage " + str.tostring(stage) + " · " + stackTxt + " · " + tradeTxt + comboExtra,
         cutSignal ? color.red : not tradeOK ? color.gray : stage == 2 ? color.green : color.red)

    // —— S · Stage ——
    if showS
        string maTxt  = trendUp ? "趋上 ▲" : trendDown ? "趋下 ▼" : "趋平 —"
        string volSTxt = upVolDominant ? "阳烛量放大" : dnVolDominant ? "阴烛量放大" : lowVolume ? "交易量低迷" : "正常"
        string rsTxt  = rsNearHigh ? "接近新高（强）" : rsNearLow ? "接近新低（弱）" : "中性"
        string mtfTxt = sameTrendUp ? "同趋上 ✔" : sameTrendDown ? "同趋下 ✔" : "不同向 ✘"
        r := f_cell(r, "S · 150均线", maTxt + "（" + stageTFUsed + " " + str.tostring(slope150, "#.##") + "%）" +
             (priceAbove150 ? " · 价在线上" : " · 价在线下"),
             trendUp ? color.green : trendDown ? color.red : color.gray)
        // Stage 1 的四个条件逐项显示：趋平 / 价在线上 / 量低迷 / 横盘≥半年
        if stage == 1
            string s1Txt = (trendFlat ? "✔" : "✘") + "趋平 " + (priceAbove150 ? "✔" : "✘") + "价在线上 " +
                 (stageLowVol ? "✔" : "✘") + "量低迷 " +
                 (sidewaysDur >= sidewaysDays ? "✔" : "✘") + "横盘" + str.tostring(sidewaysDur) + "天/" + str.tostring(sidewaysDays)
            r := f_cell(r, "S · Stage 1 条件", (stage1Confirmed ? "✅ 成立　" : "⏳ 未成立　") + s1Txt,
                 stage1Confirmed ? color.green : color.gray)
        // Stage 2 的三个条件逐项显示：趋上 / 阳烛量放大 / 强度（离均线多远）
        if stage == 2
            string s2Txt = (trendUp ? "✔" : "✘") + "趋上 " + (bullVolUp ? "✔" : "✘") + "阳烛量放大 " +
                 "强度 " + str.tostring(stageStrength, "#.#") + "%（离150均线）" +
                 (stage2Strong ? " 强" : "")
            r := f_cell(r, "S · Stage 2 条件", (stage2Confirmed ? "✅ 成立　" : "⏳ 未成立　") + s2Txt,
                 stage2Confirmed ? (stage2Strong ? color.green : color.teal) : color.gray)
        // Stage 3 的三个条件逐项显示：趋平 / 价跌穿150均线 / 阴烛量放大
        if stage == 3
            string s3Txt = (trendFlat ? "✔" : "✘") + "趋平 " +
                 (not priceAbove150 ? "✔" : "✘") + "价在线下" + (crossDn150 ? "（本根跌穿）" : "") + " " +
                 (bearVolUp ? "✔" : "✘") + "阴烛量放大"
            r := f_cell(r, "S · Stage 3 条件", (stage3Confirmed ? "⚠️ 成立　" : "⏳ 未成立　") + s3Txt,
                 stage3Confirmed ? color.red : color.gray)
        // Stage 4 的条件逐项显示：趋下 / 价在线下 / 陡度（垂直趋下=延续性强）
        if stage == 4
            string s4Txt = (trendDown ? "✔" : "✘") + "趋下 " + (not priceAbove150 ? "✔" : "✘") + "价在线下 " +
                 "陡度 " + str.tostring(slope150, "#.#") + "%" +
                 (stage4Steep ? "（垂直趋下·延续性强）" : "（慢慢趋下）") +
                 " · 离线 " + str.tostring(math.abs(stageStrength), "#.#") + "%"
            r := f_cell(r, "S · Stage 4 条件", (stage4Confirmed ? "🔻 做空时期　" : "⏳ 未成立　") + s4Txt,
                 stage4Confirmed ? color.red : color.gray)
        r := f_cell(r, "S · 交易量", volSTxt, upVolDominant ? color.green : dnVolDominant ? color.red : color.gray)
        r := f_cell(r, "S · RS 相对强度", rsTxt, rsNearHigh ? color.green : rsNearLow ? color.red : color.gray)
        r := f_cell(r, "S · 大小周期", mtfTxt + "（" + bigTF + " vs " + timeframe.period + "）", sameTrendUp or sameTrendDown ? color.teal : color.gray)
        // 扣分按当前排列方向显示：多头看 50 在 150/200 下，空头看 50 在 150/200 上
        bool alignPenActive = bullStack ? longAlignPen > 0 : bearStack and shortAlignPen > 0
        string alignPenTxt = ""
        if alignPenActive
            alignPenTxt := bullStack ? "（50在" + (ma50 < ma200 ? "150&200下 大扣-" : "150下 扣-") + str.tostring(longAlignPen) + "）" : "（50在" + (ma50 > ma200 ? "150&200上 大扣-" : "150上 扣-") + str.tostring(shortAlignPen) + "）"
        r := f_cell(r, "S · 加分", "做多 " + str.tostring(sLongScore) + "/6 · 做空 " + str.tostring(sShortScore) + "/6" + alignPenTxt,
             sLongScore >= 4 ? color.green : sShortScore >= 4 ? color.red : alignPenActive ? color.orange : color.gray)
        r := f_cell(r, "S · 图表", isNewChart ? "新图：看" + newTF + "（天图无150均线）" : "旧图：看" + stageTF, isNewChart ? color.orange : color.gray)

    // —— C · Contraction ——
    if showC
        bool countPaused = activeMode == 1 ? (stage == 1 or stage == 4) : activeMode == -1 ? (stage == 1 or stage == 2) : true
        string baseTxt = countPaused ? "计数重置中（Stage " + str.tostring(stage) + "）" :
             "#" + str.tostring(baseCount + 1) + "（已突破 " + str.tostring(baseCount) + " 个）"
        string depthTxt = ""
        if cN > 0
            for i = 0 to cN - 1
                depthTxt += "C" + str.tostring(i + 1) + " " + str.tostring(array.get(cDepth, i), "#.##") + "%  "
        else
            depthTxt := "—"
        string c1maTxt = cN >= 1 ? (c1Touched ? "✔ 有动到" : "✘ 没动到") : "—"
        string buyTxt  = cN >= 2 ? (buyZone ? "✅ 末段 " + str.tostring(lastDepth, "#.##") + "% ≤ " + str.tostring(buyPct, "#.#") + "%" :
             "未到（末段 " + str.tostring(lastDepth, "#.##") + "%）") : "结构未成立（需 ≥2 段）"
        string zoneTxt = cN >= 1 ? (isLong ?
             (close >= z1 ? "Pivot Area（顶部 1/3）" : close >= z2 ? "Cheap（中间 1/3）" : "Low Cheap（底部 1/3）") :
             (close <= z1 ? "Pivot Area（底部 1/3）" : close <= z2 ? "Cheap（中间 1/3）" : "Low Cheap（顶部 1/3）")) : "—"
        color zoneCol = cN >= 1 ? (isLong ? (close >= z1 ? color.green : close >= z2 ? color.orange : color.blue) :
             (close <= z1 ? color.green : close <= z2 ? color.orange : color.blue)) : color.gray
        // 突破区域 = 末段C的高点（＝挂单位）落在 C1 三等份的哪一份，附上确定性含义
        string brkZoneTxt = "—"
        color  brkZoneCol = color.gray
        if cN >= 2
            bool inPivot = isLong ? lastStart >= z1 : lastStart <= z1
            bool inCheap = not inPivot and (isLong ? lastStart >= z2 : lastStart <= z2)
            brkZoneTxt := inPivot ? "Pivot Area → 确定性最高" :
                 inCheap ? "Cheap Area → 确定性 + 成本优势" : "Low Cheap → 只有成本优势"
            brkZoneCol := inPivot ? color.green : inCheap ? color.orange : color.blue
        string cScoreTxt = "收缩合理" + (score1OK ? "✔" : "✘") + " C1区间" + (score2OK ? "✔" : "✘") +
             " Base≤2" + (score3OK ? "✔" : "✘") + " Pivot" + (score4OK ? "✔" : "✘") +
             " = " + str.tostring(cScore) + "/10" + (c1Reach200 ? "  ⚠️C1到200均线 扣-" + str.tostring(c1Pen200) : "")
        r := f_cell(r, "C · 目前 Base", baseTxt, countPaused ? color.gray : baseCount + 1 <= 2 ? color.teal : color.orange)
        r := f_cell(r, "C · 收缩段数", str.tostring(cN) + "（需 2~6）| " + depthTxt, cN >= 2 ? color.teal : color.gray)
        r := f_cell(r, "C · C1动到50均线", c1maTxt, cN >= 1 and c1Touched ? color.teal : color.gray)
        r := f_cell(r, "C · 买点 (≤10%)", buyTxt, buyZone ? color.green : color.gray)
        string lvTxt = cN < 1 ? "—" : (isLong ? "买点 " : "空点 ") + str.tostring(buyLevel, format.mintick) +
             " · 止损 " + str.tostring(stopLevel, format.mintick) + " · 风险 " + str.tostring(riskPct, "#.##") + "%（buffer " + str.tostring(bufPct, "#.###") + "%）"
        r := f_cell(r, "C · 买点/止损", lvTxt, cN >= 1 ? color.teal : color.gray)
        string tpTxt = na(tpRR) ? "—" : "1:" + str.tostring(rrTarget, "#.#") + " → " + str.tostring(tpRR, format.mintick) +
             " · 平均盈利×" + str.tostring(avgProfitMult, "#.#") + " → " + str.tostring(tpAvg, format.mintick)
        r := f_cell(r, "止盈目标", tpTxt, na(tpRR) ? color.gray : color.teal)
        string sellTxt = rideMode ? "被动：移动止盈 " + str.tostring(trailLevel, format.mintick) : "主动：到目标就走（非 Stage2/Base1-2）"
        if sellClimax
            sellTxt := "⚠️ 高位+大波动+大量 → 减仓"
        if sellVolDump
            sellTxt := "⚠️ 连续" + str.tostring(consecDn) + "阴烛+大量阴烛 → 出"
        r := f_cell(r, "卖出信号", sellTxt, sellClimax or sellVolDump ? color.red : rideMode ? color.teal : color.gray)
        r := f_cell(r, "C · 突破区域", brkZoneTxt, brkZoneCol)
        r := f_cell(r, "C · 现价位置", zoneTxt, zoneCol)
        r := f_cell(r, "C · 加分", cScoreTxt, cScore >= 8 ? color.green : cScore >= 5 ? color.teal : color.gray)
        r := f_cell(r, "C · 最近突破", lastBaseTxt, color.gray)

    // —— V · Volume ——
    if showV
        string structTxt = mode == 0 ? "—" : (structVolOK ? "✔ " : "✘ ") +
             "放量" + (isLong ? "阳烛量 " : "阴烛量 ") + str.tostring(isLong ? bigUpVol : bigDnVol, format.volume) +
             " vs 放量" + (isLong ? "阴烛量 " : "阳烛量 ") + str.tostring(isLong ? bigDnVol : bigUpVol, format.volume) +
             (cN >= 1 ? "（C1起算·只算量>MA50）" : "（回看" + str.tostring(volLookback) + "根·只算量>MA50）")
        string brkTxt = mode == 0 ? "—" : breakoutVolOK ? "✔ 本根 = 放量" + (isLong ? "阳烛" : "阴烛") :
             "✘ 未出现（需 " + (isLong ? "阳烛" : "阴烛") + " 且量 > 均量×" + str.tostring(breakoutMult, "#.#") + "）"
        string liqTxt = (liqOK ? "✔ " : "✘ ") + str.tostring(avgDollarVol / 1000000, "#.##") + "M（需 > " + str.tostring(minDollarM, "#.#") + "M）"
        string dayLiqTxt = (dayLiqOK ? "✔ " : "✘ ") + str.tostring(h24DollarVol / 1000000, "#.##") + "M（需 > " + str.tostring(minDollarM, "#.#") + "M）"
        string vBonusTxt = mode == 0 or cN < 1 ? "结构未成立" : (vBonusOK ? "✔ " : "✘ ") + "放量阳烛 " + str.tostring(cntUpBase) + " vs 放量阴烛 " + str.tostring(cntDnBase) + " 根（C1起算·量>MA50）"
        r := f_cell(r, "V · 阳烛量大", structTxt, structVolOK ? color.green : color.gray)
        r := f_cell(r, "V · 突破量能", brkTxt, breakoutVolOK ? color.green : color.gray)
        r := f_cell(r, "V · 日均交易金额", liqTxt, liqOK ? color.green : color.red)
        r := f_cell(r, "V · 24小时交易金额", dayLiqTxt, dayLiqOK ? color.green : color.red)
        r := f_cell(r, "V · 加分：烛数", vBonusTxt, vBonusOK ? color.green : color.gray)

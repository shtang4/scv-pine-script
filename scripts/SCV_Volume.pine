//@version=6
// ============================================================================
//  SCV 选股系统 — 第 3 部分：Volume（量能分析）
//
//  做多（多头排列时）：
//    结构 = 阴烛量小，阳烛量大
//    突破 = 阳烛量大（放量阳烛）
//    流动性 = 日交易金额超过 1 百万美元
//    加分项目 = 阳烛多，阴烛少（数量）
//  做空（空头排列时）：完全镜像
//    结构 = 阳烛量小，阴烛量大
//    突破 = 阴烛量大（放量阴烛）
//    流动性 = 日交易金额超过 1 百万美元
//    加分项目 = 阳烛少，阴烛多（数量）
// ============================================================================
indicator("SCV - Volume 量能分析", shorttitle = "SCV-V", overlay = false, format = format.volume)

// ============================== 输入 Inputs ===============================
grpMA = "① 均线（判断多头/空头排列）"
len50  = input.int(50,  "50 均线",  minval = 1, group = grpMA)
len150 = input.int(150, "150 均线", minval = 1, group = grpMA)
len200 = input.int(200, "200 均线", minval = 1, group = grpMA)
stackMode = input.string("宽松：150>200", "多头/空头排列定义", options = ["宽松：150>200", "严格：50>150>200"], group = grpMA, tooltip = "宽松：只要 150 在 200 上就算多头排列，50 的位置只影响扣分档次（C1 可以早一点开始）。严格：要 50 在最上、150 中间、200 最下的完美排列才算（教材定义，C1 会出现得晚、数量少）。空头排列镜像")

grpVol = "② 量能"
volLookback  = input.int(20,     "量能回看K线数",       minval = 1, group = grpVol, tooltip = "在这段期间比较 放量阳烛的量 vs 放量阴烛的量")
volRatio     = input.float(1.2,  "量大倍数",            minval = 1.0, step = 0.1, group = grpVol, tooltip = "放量阳烛总量 > 放量阴烛总量 × 此倍数 = 阳烛量大（做空反过来）")
volMALen     = input.int(50,     "交易量均线长度",      minval = 1, group = grpVol)
breakoutMult = input.float(1.5,  "突破放量倍数",        minval = 1.0, step = 0.1, group = grpVol, tooltip = "突破量能：当根量 > 交易量均线(MA50)×此倍数 = 放量")
dojiPct      = input.float(50.0, "变盘线：实体 < K线范围 (%)", minval = 1, maxval = 100, group = grpVol, tooltip = "蜡烛分三种：变盘线 = 上下影线合计比实体长（不管阴阳）；阳烛/阴烛 = 实体大过影线合计再看颜色。变盘线不算进阳烛/阴烛的统计")

grpLiq = "③ 流动性"
minDollarM   = input.float(1.0, "最低日均交易金额（百万）", minval = 0.1, step = 0.1, group = grpLiq, tooltip = "日均 收盘价×成交量 要超过此金额（单位=该股计价货币，美股即美元）")
dollarLookback = input.int(20,  "交易金额平均回看天数",   minval = 1, group = grpLiq, tooltip = "取几个交易日的日金额来平均")

grpDraw = "④ 图表显示（每样都可以关）"
showVolBars  = input.bool(true, "成交量柱",                group = grpDraw)
showVolMA    = input.bool(true, "交易量均线（橙线）",       group = grpDraw)
showVolThr   = input.bool(true, "突破放量门槛线",           group = grpDraw)
showVolMarks = input.bool(true, "放量阳烛 / 放量阴烛 三角", group = grpDraw)
showLiqBg    = input.bool(true, "流动性不足红色背景",       group = grpDraw)

grpPanel = "⑤ 面板"
showPanel = input.bool(true, "显示面板", group = grpPanel)
panelPosTxt = input.string("右中", "面板位置", options = ["右上", "右中", "右下", "中上", "中下", "左上", "左中", "左下"], group = grpPanel, tooltip = "选面板显示在图上的哪个角落（TradingView 的表格不能用鼠标拖动）")
panelPos = panelPosTxt == "右上" ? position.top_right : panelPosTxt == "右中" ? position.middle_right : panelPosTxt == "右下" ? position.bottom_right : panelPosTxt == "中上" ? position.top_center : panelPosTxt == "中下" ? position.bottom_center : panelPosTxt == "左上" ? position.top_left : panelPosTxt == "左中" ? position.middle_left : position.bottom_left
panelSizeTxt = input.string("小", "面板文字大小", options = ["极小", "小", "正常", "大"], group = grpPanel)
panelSize = panelSizeTxt == "极小" ? size.tiny : panelSizeTxt == "小" ? size.small : panelSizeTxt == "正常" ? size.normal : size.large

// ========================== 排列 / 方向 ====================================
ma50  = ta.sma(close, len50)
ma150 = ta.sma(close, len150)
ma200 = ta.sma(close, len200)
// 宽松：只要 150 在 200 上（50 的位置只决定扣分档次）
// 严格：50 在最上、150 中间、200 最下的完美排列（教材定义）
bool strictStack = stackMode == "严格：50>150>200"
bullStack = strictStack ? (ma50 > ma150 and ma150 > ma200) : ma150 > ma200
bearStack = strictStack ? (ma50 < ma150 and ma150 < ma200) : ma150 < ma200
int mode = bullStack ? 1 : bearStack ? -1 : 0
bool isLong = mode == 1

// ========================== 阴阳烛量能统计 ==================================
// 蜡烛分三种：身体 = |收 − 开|；影线合计 = 整根范围 − 身体
//   变盘线 = 影线合计 > 身体（不管阴阳）· 阳烛/阴烛 = 身体大过影线合计再看颜色
float candBody = math.abs(close - open)
float candRng  = high - low
bool isChg = candRng == 0 or candBody < candRng * dojiPct / 100   // 变盘线
bool isUp  = not isChg and close > open   // 阳烛
bool isDn  = not isChg and close < open   // 阴烛

// —— 突破量能（当根K线） ——
float volMA  = ta.sma(volume, volMALen)
bool  bigVol = volume > volMA * breakoutMult

// —— 条件① 阳烛量大 ——
// 只看「超过 50 交易量均线（橙线）」的蜡烛，橙线以下的一概忽略不计
float bigUpVol = math.sum(isUp and volume > volMA ? volume : 0, volLookback)
float bigDnVol = math.sum(isDn and volume > volMA ? volume : 0, volLookback)
bool structVolOK = mode != 0 and (isLong ? bigUpVol > bigDnVol * volRatio : bigDnVol > bigUpVol * volRatio)

bool  breakoutVolOK = mode != 0 and bigVol and (isLong ? isUp : isDn)   // 做多要放量阳烛，做空要放量阴烛

// —— 流动性：日均交易金额 ——
// 不管图表周期（1小时/5分钟…），都强制取「天」的 收盘价×成交量 再平均，
// 否则在日内图上算的是「每根K线」的金额，会比真正的日金额小很多
float avgDollarVol = request.security(syminfo.tickerid, "D", ta.sma(close * volume, dollarLookback))
bool  liqOK        = avgDollarVol > minDollarM * 1000000
// 另外单看「过去 24 小时」的交易金额有没有超过门槛：
// 取 1 小时图的 收盘价×成交量，滚动累加最近 24 根（= 过去 24 小时，币 7×24 连续）
float h24DollarVol = request.security(syminfo.tickerid, "60", math.sum(close * volume, 24))
bool  dayLiqOK     = h24DollarVol > minDollarM * 1000000

// —— 加分项目：放量阳烛多、放量阴烛少（做多）/ 放量阴烛多、放量阳烛少（做空） ——
// 只算「放量」的蜡烛：量要超过 交易量均线(MA50) 才计入（量太小的当杂讯不计）
int cntUpBig = int(math.sum(isUp and volume > volMA ? 1 : 0, volLookback))
int cntDnBig = int(math.sum(isDn and volume > volMA ? 1 : 0, volLookback))
bool bonusOK = mode != 0 and (isLong ? cntUpBig > cntDnBig : cntDnBig > cntUpBig)

// ============================ 副图显示 =====================================
// 成交量柱：阳烛绿、阴烛红、放量加深、变盘线灰（影线大过实体，两边都不计）
color volCol = isUp ? (bigVol ? color.new(color.green, 0) : color.new(color.green, 55)) :
     isDn ? (bigVol ? color.new(color.red, 0) : color.new(color.red, 55)) : color.new(color.gray, 40)
plot(showVolBars ? volume : na, "成交量", color = volCol, style = plot.style_columns)
plot(showVolMA ? volMA : na, "均量", color = color.new(color.orange, 0), linewidth = 2)
plot(showVolThr ? volMA * breakoutMult : na, "突破放量门槛", color = color.new(color.orange, 70), linewidth = 1)

// 突破量能确认标记
plotshape(showVolMarks and breakoutVolOK and isLong,     "放量阳烛（做多突破量）", style = shape.triangleup,   location = location.top, color = color.green, size = size.tiny)
plotshape(showVolMarks and breakoutVolOK and not isLong, "放量阴烛（做空突破量）", style = shape.triangledown, location = location.top, color = color.red,   size = size.tiny)

// 流动性不足 → 整个副图淡红色警告
bgcolor(showLiqBg and not liqOK ? color.new(color.red, 85) : na, title = "流动性不足警告")

// ============================ 信息面板 =====================================
var table panel = table.new(panelPos, 2, 7, border_width = 1, border_color = color.new(color.gray, 60))
f_cell(int row, string k, string v, color c) =>
    table.cell(panel, 0, row, k, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = panelSize, text_halign = text.align_left)
    table.cell(panel, 1, row, v, text_color = color.white, bgcolor = color.new(c, 30), text_size = panelSize, text_halign = text.align_left)

if barstate.islast and not showPanel
    table.clear(panel, 0, 0, 1, 6)

if barstate.islast and showPanel
    string modeTxt   = (mode == 1 ? "多头排列 → 做多量能" : mode == -1 ? "空头排列 → 做空量能" : "无排列 → 暂停") + "（" + timeframe.period + "）"
    string structTxt = mode == 0 ? "—" : (structVolOK ? "✔ " : "✘ ") +
         "放量" + (isLong ? "阳烛量 " : "阴烛量 ") + str.tostring(isLong ? bigUpVol : bigDnVol, format.volume) +
         " vs 放量" + (isLong ? "阴烛量 " : "阳烛量 ") + str.tostring(isLong ? bigDnVol : bigUpVol, format.volume) +
         "（只算量>MA" + str.tostring(volMALen) + "）"
    string brkTxt    = mode == 0 ? "—" : breakoutVolOK ? "✔ 本根 = 放量" + (isLong ? "阳烛" : "阴烛") :
         "✘ 未出现（需 " + (isLong ? "阳烛" : "阴烛") + " 且量 > 均量×" + str.tostring(breakoutMult, "#.#") + "）"
    string liqTxt    = (liqOK ? "✔ " : "✘ ") + str.tostring(avgDollarVol / 1000000, "#.##") + "M（需 > " + str.tostring(minDollarM, "#.#") + "M）"
    string dayLiqTxt = (dayLiqOK ? "✔ " : "✘ ") + str.tostring(h24DollarVol / 1000000, "#.##") + "M（需 > " + str.tostring(minDollarM, "#.#") + "M）"
    string bonusTxt  = mode == 0 ? "—" : (bonusOK ? "✔ " : "✘ ") + "放量阳烛 " + str.tostring(cntUpBig) + " 根 vs 放量阴烛 " + str.tostring(cntDnBig) + " 根（量>MA50）"
    int okCount = (structVolOK ? 1 : 0) + (liqOK ? 1 : 0) + (bonusOK ? 1 : 0)
    string sumTxt = mode == 0 ? "暂停侦测" : str.tostring(okCount) + "/3" + (breakoutVolOK ? " + 突破放量 ✔" : "（突破日再看放量）")

    f_cell(0, "排列 / 方向", modeTxt, mode == 1 ? color.green : mode == -1 ? color.red : color.gray)
    f_cell(1, "阳烛量大",    structTxt, structVolOK ? color.green : color.gray)
    f_cell(2, "突破量能",    brkTxt, breakoutVolOK ? color.green : color.gray)
    f_cell(3, "日均交易金额", liqTxt, liqOK ? color.green : color.red)
    f_cell(4, "24小时交易金额", dayLiqTxt, dayLiqOK ? color.green : color.red)
    f_cell(5, "加分：烛数",   bonusTxt, bonusOK ? color.green : color.gray)
    f_cell(6, "Volume 总评",  sumTxt, okCount == 3 ? color.green : okCount == 2 ? color.teal : color.gray)

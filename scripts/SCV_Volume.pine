//@version=6
// ============================================================================
//  SCV 选股系统 — 第 3 部分：Volume（量能分析）
//
//  做多（多头排列时）：
//    结构 = 阴烛量小，阳烛量大
//    突破 = 阳烛量大（放量阳烛）
//    流动性 = 日交易金额超过 1 百万美元
//    加分项目 = 阳烛多，阴烛少（数量）
//  做空（空头排列时）：完全镜像
//    结构 = 阳烛量小，阴烛量大
//    突破 = 阴烛量大（放量阴烛）
//    流动性 = 日交易金额超过 1 百万美元
//    加分项目 = 阳烛少，阴烛多（数量）
// ============================================================================
indicator("SCV - Volume 量能分析", shorttitle = "SCV-V", overlay = false, format = format.volume)

// ============================== 输入 Inputs ===============================
grpMA = "① 均线（判断多头/空头排列）"
len50  = input.int(50,  "50 均线",  minval = 1, group = grpMA)
len150 = input.int(150, "150 均线", minval = 1, group = grpMA)
len200 = input.int(200, "200 均线", minval = 1, group = grpMA)

grpVol = "② 量能"
volLookback  = input.int(20,     "结构量能回看K线数",   minval = 1, group = grpVol, tooltip = "在这段期间比较 阳烛平均量 vs 阴烛平均量")
volRatio     = input.float(1.2,  "量大倍数",            minval = 1.0, step = 0.1, group = grpVol, tooltip = "阳烛平均量 > 阴烛平均量 × 此倍数 = 阳烛量大（做空反过来）")
volMALen     = input.int(50,     "交易量均线长度",      minval = 1, group = grpVol)
breakoutMult = input.float(1.5,  "突破放量倍数",        minval = 1.0, step = 0.1, group = grpVol, tooltip = "当根K线量 > 均量 × 此倍数 = 放量")

grpLiq = "③ 流动性"
minDollarM   = input.float(1.0, "最低日均交易金额（百万）", minval = 0.1, step = 0.1, group = grpLiq, tooltip = "日均 收盘价×成交量 要超过此金额（单位=该股计价货币，美股即美元）")
dollarLookback = input.int(20,  "交易金额平均回看天数",   minval = 1, group = grpLiq, tooltip = "取几个交易日的日金额来平均")

// ========================== 排列 / 方向 ====================================
ma50  = ta.sma(close, len50)
ma150 = ta.sma(close, len150)
ma200 = ta.sma(close, len200)
// 多头排列 = 150 在 200 上（50 的位置只决定扣分档次，不影响排列成立）
bullStack = ma150 > ma200
bearStack = ma150 < ma200
int mode = bullStack ? 1 : bearStack ? -1 : 0
bool isLong = mode == 1

// ========================== 阴阳烛量能统计 ==================================
bool isUp = close > open   // 阳烛
bool isDn = close < open   // 阴烛

// 回看期内：阳烛/阴烛的 总量、根数、平均量
float sumUpVol = math.sum(isUp ? volume : 0, volLookback)
float sumDnVol = math.sum(isDn ? volume : 0, volLookback)
int   cntUp    = int(math.sum(isUp ? 1 : 0, volLookback))
int   cntDn    = int(math.sum(isDn ? 1 : 0, volLookback))
float avgUpVol = cntUp > 0 ? sumUpVol / cntUp : 0
float avgDnVol = cntDn > 0 ? sumDnVol / cntDn : 0

// —— 结构量能 ——
// 做多：阳烛平均量 > 阴烛平均量 × 倍数（阴烛量小，阳烛量大）
// 做空：阴烛平均量 > 阳烛平均量 × 倍数（阳烛量小，阴烛量大）
bool structVolOK = mode != 0 and (isLong ? avgUpVol > avgDnVol * volRatio : avgDnVol > avgUpVol * volRatio)

// —— 突破量能（当根K线） ——
float volMA  = ta.sma(volume, volMALen)
bool  bigVol = volume > volMA * breakoutMult
bool  breakoutVolOK = mode != 0 and bigVol and (isLong ? isUp : isDn)   // 做多要放量阳烛，做空要放量阴烛

// —— 流动性：日均交易金额 ——
// 不管图表周期（1小时/5分钟…），都强制取「天」的 收盘价×成交量 再平均，
// 否则在日内图上算的是「每根K线」的金额，会比真正的日金额小很多
float avgDollarVol = request.security(syminfo.tickerid, "D", ta.sma(close * volume, dollarLookback))
bool  liqOK        = avgDollarVol > minDollarM * 1000000

// —— 加分项目：阳烛多阴烛少（做多）/ 阳烛少阴烛多（做空） ——
bool bonusOK = mode != 0 and (isLong ? cntUp > cntDn : cntDn > cntUp)

// ============================ 副图显示 =====================================
// 成交量柱：阳烛绿、阴烛红、放量加深、十字星灰
color volCol = isUp ? (bigVol ? color.new(color.green, 0) : color.new(color.green, 55)) :
     isDn ? (bigVol ? color.new(color.red, 0) : color.new(color.red, 55)) : color.new(color.gray, 40)
plot(volume, "成交量", color = volCol, style = plot.style_columns)
plot(volMA, "均量", color = color.new(color.orange, 0), linewidth = 2)
plot(volMA * breakoutMult, "突破放量门槛", color = color.new(color.orange, 70), linewidth = 1)

// 突破量能确认标记
plotshape(breakoutVolOK and isLong,     "放量阳烛（做多突破量）", style = shape.triangleup,   location = location.top, color = color.green, size = size.tiny)
plotshape(breakoutVolOK and not isLong, "放量阴烛（做空突破量）", style = shape.triangledown, location = location.top, color = color.red,   size = size.tiny)

// 流动性不足 → 整个副图淡红色警告
bgcolor(not liqOK ? color.new(color.red, 85) : na)

// ============================ 信息面板 =====================================
var table panel = table.new(position.top_right, 2, 6, border_width = 1, border_color = color.new(color.gray, 60))
f_cell(int row, string k, string v, color c) =>
    table.cell(panel, 0, row, k, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, row, v, text_color = color.white, bgcolor = color.new(c, 30), text_size = size.small, text_halign = text.align_left)

if barstate.islast
    string modeTxt   = mode == 1 ? "多头排列 → 做多量能" : mode == -1 ? "空头排列 → 做空量能" : "无排列 → 暂停"
    string structTxt = mode == 0 ? "—" : (structVolOK ? "✔ " : "✘ ") +
         (isLong ? "阳烛量 " : "阴烛量 ") + str.tostring(isLong ? avgUpVol : avgDnVol, format.volume) +
         " vs " + (isLong ? "阴烛量 " : "阳烛量 ") + str.tostring(isLong ? avgDnVol : avgUpVol, format.volume)
    string brkTxt    = mode == 0 ? "—" : breakoutVolOK ? "✔ 本根 = 放量" + (isLong ? "阳烛" : "阴烛") :
         "✘ 未出现（需 " + (isLong ? "阳烛" : "阴烛") + " 且量 > 均量×" + str.tostring(breakoutMult, "#.#") + "）"
    string liqTxt    = (liqOK ? "✔ " : "✘ ") + str.tostring(avgDollarVol / 1000000, "#.##") + "M（需 > " + str.tostring(minDollarM, "#.#") + "M）"
    string bonusTxt  = mode == 0 ? "—" : (bonusOK ? "✔ " : "✘ ") + "阳烛 " + str.tostring(cntUp) + " 根 vs 阴烛 " + str.tostring(cntDn) + " 根"
    int okCount = (structVolOK ? 1 : 0) + (liqOK ? 1 : 0) + (bonusOK ? 1 : 0)
    string sumTxt = mode == 0 ? "暂停侦测" : str.tostring(okCount) + "/3" + (breakoutVolOK ? " + 突破放量 ✔" : "（突破日再看放量）")

    f_cell(0, "排列 / 方向", modeTxt, mode == 1 ? color.green : mode == -1 ? color.red : color.gray)
    f_cell(1, "结构量能",    structTxt, structVolOK ? color.green : color.gray)
    f_cell(2, "突破量能",    brkTxt, breakoutVolOK ? color.green : color.gray)
    f_cell(3, "日均交易金额", liqTxt, liqOK ? color.green : color.red)
    f_cell(4, "加分：烛数",   bonusTxt, bonusOK ? color.green : color.gray)
    f_cell(5, "Volume 总评",  sumTxt, okCount == 3 ? color.green : okCount == 2 ? color.teal : color.gray)
